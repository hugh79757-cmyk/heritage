---
import GuideLayout from '../../components/GuideLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import FAQSection from '../../components/FAQSection.astro';
import '../../styles/global.css';
import { PALACES, getLang, fetchPalaceList } from '../../lib/api';

const lang = getLang(Astro.url);
const htmlLang = lang === 'kr' ? 'ko' : lang;
const buildings = await fetchPalaceList(2);

const title = 'Changdeokgung Palace Complete Guide 2026 | K-Heritage';
const description = 'Complete guide to Changdeokgung Palace: Secret Garden reservation, ticket prices, opening hours, must-see buildings, and visitor tips for 2026.';

const faqByLang: Record<string, { question: string; answer: string }[]> = {
  kr: [
    { question: '창덕궁 비원은 어떻게 방문하나요?', answer: '비원(후원)은 별도의 가이드 투어가 필요합니다. 국가유산청 홈페이지(heritage.go.kr)에서 사전 예약 필수. 투어는 10:00, 11:00, 14:00, 15:30에 출발하며 빠르게 매진됩니다.' },
    { question: '창덕궁 입장료는?', answer: '궁궐: 성인 ₩3,000, 청소년 ₩1,500. 비원: 성인 ₩5,000, 청소년 ₩2,500. 통합: ₩8,000. 7세 이하·65세 이상 무료.' },
    { question: '창덕궁은 UNESCO 세계유산인가요?', answer: '네, 1997년 UNESCO 세계유산으로 지정되었습니다. 자연 지형과 조화를 이룬 뛰어난 건축으로 인정받았습니다.' },
    { question: '방문 시간은 얼마나 걸리나요?', answer: '궁궐만 약 1~1.5시간, 비원 투어 포함 시 약 3시간. 돈화문과 후원 지역 추가 시간 확보 권장.' },
    { question: '방문하기 가장 좋은 시즌은?', answer: '가을(10월 중순~11월)이 가장 아름답습니다. 비원 단풍이 붉고 금빛으로 물듭니다. 봄 벚꽃과 여름 연꽃도 장관입니다.' },
  ],
  en: [
    { question: 'How do I visit the Changdeokgung Secret Garden?', answer: 'The Secret Garden (비원) requires a separate guided tour. Book tickets through heritage.go.kr. Tours run at 10:00, 11:00, 14:00, 15:30 and sell out quickly.' },
    { question: 'What is the ticket price?', answer: 'Palace: ₩3,000 adults, ₩1,500 youth. Secret Garden: ₩5,000 adults, ₩2,500 youth. Combined: ₩8,000. Free for children under 7 and seniors 65+.' },
    { question: 'Is it UNESCO World Heritage?', answer: 'Yes, designated in 1997 for its exceptional architecture harmonizing with the natural landscape.' },
    { question: 'How long does a visit take?', answer: 'Palace alone: 1-1.5 hours. With Secret Garden tour: about 3 hours total.' },
    { question: 'Best season to visit?', answer: 'Autumn (mid-Oct to Nov) for vibrant foliage. Spring cherry blossoms and summer lotus are also spectacular.' },
  ],
  ja: [
    { question: '昌德宮秘苑はどうやって訪問しますか？', answer: '秘苑は別途ガイドツアーが必要です。heritage.go.krで事前予約。ツアーは10:00、11:00、14:00、15:30出発。すぐに完売します。' },
    { question: '入場料は？', answer: '宮殿: 大人₩3,000、青少年₩1,500。秘苑: 大人₩5,000、青少年₩2,500。統合: ₩8,000。7歳以下・65歳以上無料。' },
    { question: 'UNESCO世界遺産ですか？', answer: 'はい、1997年に自然の地形と調和した建築で世界遺産に指定されました。' },
    { question: '訪問時間は？', answer: '宮殿のみ1〜1.5時間。秘苑ツアー込みで約3時間。' },
    { question: 'ベストシーズンは？', answer: '秋（10月中旬〜11月）の紅葉が最も美しい。春の桜と夏の蓮も見事です。' },
  ],
  zh: [
    { question: '如何参观昌德宫秘苑？', answer: '秘苑需要单独的导览团。在heritage.go.kr提前预约。每天10:00、11:00、14:00、15:30出发，很快售罄。' },
    { question: '门票价格？', answer: '宫殿: 成人₩3,000，青少年₩1,500。秘苑: 成人₩5,000，青少年₩2,500。综合: ₩8,000。7岁以下·65岁以上免费。' },
    { question: '是UNESCO世界遗产吗？', answer: '是的，1997年被列入世界遗产，以与自然地形和谐融合的建筑闻名。' },
    { question: '游览需要多长时间？', answer: '宫殿约1-1.5小时，含秘苑导览约3小时。' },
    { question: '最佳游览季节？', answer: '秋季（10月中旬至11月）红叶最美。春季樱花和夏季莲花也很壮观。' },
  ],
};
const faqItems = faqByLang[lang] || faqByLang.en;

const headings: Record<string, { h1: string; intro: string; h2_1: string; h2_2: string; h2_3: string; h2_4: string; h2_5: string; info_1: string; info_2: string; buildings_text: string; cta: string }> = {
  en: {
    h1: 'Changdeokgung Palace Complete Guide 2026',
    intro: 'Changdeokgung Palace (창덕궁) is a UNESCO World Heritage Site, renowned for its exceptional architecture that harmonizes with the natural topography. Built in 1405, it served as the secondary palace of the Joseon dynasty and was favored by many kings for its beautiful layout. The attached Secret Garden (비원/Huwon) is considered one of the finest examples of Korean garden design.',
    h2_1: 'Ticket Prices & Secret Garden Reservation',
    h2_2: 'Opening Hours & Tour Schedule',
    h2_3: 'How to Get There',
    h2_4: 'Must-See Buildings & Secret Garden Highlights',
    h2_5: 'Visitor Tips',
    info_1: 'Palace admission: ₩3,000 (adults), ₩1,500 (youth 7-18). Secret Garden: ₩5,000 (adults), ₩2,500 (youth). Combined: ₩8,000. Children under 7 and seniors 65+ are free.',
    info_2: 'Palace: 09:00–18:00 (Feb–Oct), 09:00–17:00 (Nov–Jan). Closed Tuesdays. Secret Garden guided tours: 10:00, 11:00, 14:00, 15:30 daily. Each tour accommodates ~100 visitors and lasts approximately 90 minutes.',
    buildings_text: 'Changdeokgung features buildings arranged along the natural terrain rather than a rigid grid. Notable structures include Donhwamun Gate (the main entrance with its unique arched design), Injeongjeon Hall (the throne hall), Seonjeongjeon (the king\'s office), and Buyongjeong Pavilion.',
    cta: 'Explore all buildings at Changdeokgung →',
  },
  kr: {
    h1: '창덕궁 완전 가이드 2026',
    intro: '창덕궁(昌德宮)은 UNESCO 세계유산으로, 자연 지형과 조화를 이룬 뛰어난 건축으로 유명합니다. 1405년 건립된 이 궁궐은 조선 왕조의 이궁으로 많은 왕들이 사랑했습니다. 부속된 후원(비원)은 한국 정원 디자인의 걸작으로 꼽힙니다.',
    h2_1: '관람권 및 비원 예약',
    h2_2: '개방시간 및 투어 일정',
    h2_3: '교통 안내',
    h2_4: '주요 건축물 및 비원 하이라이트',
    h2_5: '관람 팁',
    info_1: '궁궐: 성인 ₩3,000, 청소년 ₩1,500. 비원: 성인 ₩5,000, 청소년 ₩2,500. 통합: ₩8,000. 7세 이하 및 65세 이상 무료.',
    info_2: '궁궐: 09:00~18:00(2~10월), 09:00~17:00(11~1월). 매주 화요일 휴관. 비원 가이드 투어: 매일 10:00, 11:00, 14:00, 15:30. 회당 약 100명, 약 90분 소요.',
    buildings_text: '창덕궁은 격자형 배치 대신 자연 지형을 따라 건물을 배치한 것이 특징입니다. 돈화문(정문), 인정전(전정), 선정전(왕의 집무실), 부용정(연못 위 정자) 등이 대표적입니다.',
    cta: '창덕궁 건물 전체 보기 →',
  },
  ja: {
    h1: '昌德宮 完全ガイド 2026',
    intro: '昌德宮（창덕궁）はUNESCO世界遺産で、自然の地形と調和した優れた建築で知られています。1405年に築かれたこの宮殿は朝鮮王朝の離宮で、多くの王に愛されました。付属の秘苑（后園）は韓国庭園デザインの傑作とされています。',
    h2_1: 'チケット料金と秘苑予約',
    h2_2: '営業時間とツアー日程',
    h2_3: 'アクセス方法',
    h2_4: '見どころ建築物と秘苑ハイライト',
    h2_5: '観光ヒント',
    info_1: '宮殿：大人₩3,000、青少年₩1,500。秘苑：大人₩5,000、青少年₩2,500。統合：₩8,000。7歳以下及び65歳以上無料。',
    info_2: '宮殿：09:00〜18:00（2〜10月）、09:00〜17:00（11〜1月）。毎週火曜休館。秘苑ガイドツアー：毎日10:00、11:00、14:00、15:30。回あたり約100名、約90分。',
    buildings_text: '昌德宮は格子型配置ではなく自然の地形に沿って建物を配置するのが特徴です。敦化門（正門）、仁政殿（正殿）、宣政殿（執務室）、芙蓉亭（蓮池上の亭）などが代表的です。',
    cta: '昌德宮の全建築物を見る →',
  },
  zh: {
    h1: '昌德宫完全指南 2026',
    intro: '昌德宫（창덕궁）是UNESCO世界遗产，以与自然地形和谐融合的卓越建筑闻名。建于1405年，作为朝鲜王朝的离宫深受多位国王喜爱。附属的后苑（秘苑）被视为韩国园林设计的杰作。',
    h2_1: '门票价格与秘苑预约',
    h2_2: '开放时间与导览日程',
    h2_3: '交通指南',
    h2_4: '必看建筑与秘苑亮点',
    h2_5: '游客贴士',
    info_1: '宫殿：成人₩3,000，青少年₩1,500。秘苑：成人₩5,000，青少年₩2,500。综合：₩8,000。7岁以下及65岁以上免费。',
    info_2: '宫殿：09:00-18:00（2-10月），09:00-17:00（11-1月）。每周二闭馆。秘苑导览：每天10:00、11:00、14:00、15:30。每场约100人，约90分钟。',
    buildings_text: '昌德宫的特点是不采用格子型布局，而是沿自然地形布置建筑。敦化门（正门）、仁政殿（正殿）、宣政殿（办公室）、芙蓉亭（莲池上的亭子）等为代表性建筑。',
    cta: '查看昌德宫全部建筑 →',
  },
};

const h = headings[lang] || headings.en;

function getBldName(b: typeof buildings[0]) {
  const map: Record<string, string> = { kr: b.nameKr, en: b.nameEn, ja: b.nameJa, zh: b.nameZh };
  return map[lang] || b.nameEn;
}
---
<GuideLayout title={title} description={description} lang={htmlLang}>
  <style>
    @import '../../styles/global.css';
  </style>

  <div class="container">
    <BreadcrumbNav items={[{ name: 'Home', url: '/' }, { name: 'Guide', url: '/guide' }, { name: 'Changdeokgung' }]} lang={lang} />

    <article class="guide-content">
      <h1>{h.h1}</h1>
      <p class="guide-meta">Updated: June 2026 &middot; Korea Heritage Service official data</p>

      <img class="guide-hero-img" src="https://www.heritage.go.kr/gung/gogung2/images/img_changdeok_story_bg_00_00.jpg" alt="Changdeokgung Palace" width="960" height="400" />

      <p class="guide-intro">{h.intro}</p>

      <h2>{h.h2_1}</h2>
      <div class="info-box">
        <p>{h.info_1}</p>
      </div>
      <p>The Secret Garden tour is the highlight of any Changdeokgung visit. Reservations open on the Korea Heritage Service website (heritage.go.kr) and sell out extremely fast. We recommend checking availability exactly when new dates are released — typically on the 1st of each month for the following month.</p>
      <p>The palace ticket alone allows you to explore the main palace buildings without a guide. However, the Secret Garden requires a guided tour and cannot be visited independently.</p>

      <h2>{h.h2_2}</h2>
      <div class="info-box">
        <p>{h.info_2}</p>
      </div>
      <p>The Secret Garden tour follows a set route through the 78-acre garden, passing by Buyongji Pond, Juhamnu Pavilion, Ongnyucheon Stream, and the Yeongyeongdang Residence. Each season reveals a different beauty — cherry blossoms in spring, lush greenery in summer, vibrant foliage in autumn, and serene snowscapes in winter.</p>

      <h2>{h.h2_3}</h2>
      <p><strong>Subway:</strong> Seoul Metro Line 3 to Anguk Station (Exit 3) — 5 minute walk, or Line 3 Jongno 3-ga Station (Exit 6) — 8 minute walk.</p>
      <p><strong>Bus:</strong> Routes 101, 162, 171, 272, 606 stop near Anguk. Walk from Anguk Station Exit 3 toward the palace.</p>

      <h2>{h.h2_4}</h2>
      <p>{h.buildings_text}</p>

      <div class="building-highlights">
        {buildings.slice(0, 6).map(b => (
          <a href={`/palace/2/${b.detailCode}?sn=${b.serialNumber}&lang=${lang}`} class="building-highlight-card">
            {b.imageUrl && <img src={b.imageUrl} alt={getBldName(b)} loading="lazy" width="120" height="80" />}
            <div>
              <h4>{getBldName(b)}</h4>
              <p>{b.explanationKr.replace(/<br\s*\/?>/g, ' ').slice(0, 60)}...</p>
            </div>
          </a>
        ))}
      </div>

      <div class="cta-box">
        <a href={`/palace/2?lang=${lang}`}>{h.cta}</a>
      </div>

      <h2>{h.h2_5}</h2>
      <div class="info-box tip-box">
        <p><strong>Visitor Tips:</strong></p>
        <ul>
          <li>Book Secret Garden tickets at least 1-2 weeks in advance — they sell out within hours</li>
          <li>Wear comfortable walking shoes — the Secret Garden tour involves 2+ km of walking</li>
          <li>The palace is beautiful in every season, but autumn (mid-October) offers the most stunning views</li>
          <li>Photography is allowed in most areas, but tripods may be restricted during peak hours</li>
          <li>Audio guides are available at the entrance in multiple languages</li>
          <li>Free admission with hanbok — nearby rental shops are plentiful around Anguk Station</li>
        </ul>
      </div>

      <FAQSection items={faqByLang} lang={lang} />
    </article>
  </div>
</GuideLayout>

<style>
  .guide-content {
    padding: 80px 0 60px;
    max-width: 800px;
    margin: 0 auto;
  }
  .guide-content h1 {
    font-family: 'Noto Serif KR', serif;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .guide-meta {
    font-size: 0.85rem;
    color: var(--color-text-muted, #9A8B7F);
    margin-bottom: 24px;
  }
  .guide-hero-img {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 16px;
    margin-bottom: 32px;
  }
  .guide-intro {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 32px;
    color: var(--color-text-light, #6B5B4F);
  }
  .guide-content h2 {
    font-family: 'Noto Serif KR', serif;
    font-size: 1.4rem;
    font-weight: 700;
    margin-top: 48px;
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--color-accent, #D4A574);
  }
  .guide-content p {
    font-size: 1rem;
    line-height: 1.9;
    margin-bottom: 16px;
  }
  .info-box {
    background: var(--color-card, #fff);
    border: 1px solid var(--color-border, #E8DDD4);
    border-radius: 12px;
    padding: 20px;
    margin: 16px 0 24px;
  }
  html.dark .info-box {
    background: var(--color-card, #1C1916);
    border-color: var(--color-border, #2D2720);
  }
  .tip-box {
    border-left: 4px solid var(--color-primary, #C8956C);
  }
  .info-box ul {
    margin-top: 8px;
    padding-left: 20px;
  }
  .info-box li {
    margin-bottom: 6px;
    line-height: 1.6;
    font-size: 0.95rem;
  }
  .building-highlights {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
    margin: 20px 0 24px;
  }
  .building-highlight-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background: var(--color-card, #fff);
    border: 1px solid var(--color-border, #E8DDD4);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s;
  }
  html.dark .building-highlight-card {
    background: var(--color-card, #1C1916);
    border-color: var(--color-border, #2D2720);
  }
  .building-highlight-card:hover {
    border-color: var(--color-primary, #C8956C);
  }
  .building-highlight-card img {
    width: 80px;
    height: 56px;
    object-fit: cover;
    border-radius: 8px;
    flex-shrink: 0;
  }
  .building-highlight-card h4 {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--color-text, #1A1210);
  }
  .building-highlight-card p {
    font-size: 0.78rem;
    color: var(--color-text-muted, #9A8B7F);
    margin: 0;
    line-height: 1.4;
  }
  .cta-box {
    text-align: center;
    margin: 32px 0;
  }
  .cta-box a {
    display: inline-block;
    padding: 14px 32px;
    background: var(--color-primary, #C8956C);
    color: #fff;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: background 0.3s, transform 0.2s;
  }
  .cta-box a:hover {
    background: var(--color-primary-dark, #8B5E3C);
    transform: translateY(-2px);
  }
  @media (max-width: 640px) {
    .building-highlights { grid-template-columns: 1fr; }
  }
</style>
