---
export interface Props {
  asno: string;
  ctcd?: string;
  kdcd?: string;
  lang?: string;
  name: string;
  explanation?: string;
}

const { asno, ctcd = '11', kdcd = '11', lang = 'kr', name, explanation } = Astro.props;

const titles: Record<string, string> = {
  kr: '오디오 가이드',
  en: 'Audio Guide',
  ja: 'オーディオガイド',
  zh: '语音导览',
};

const noAudioMsgs: Record<string, string> = {
  kr: '아직 녹음이 없습니다',
  en: 'No audio yet',
  ja: 'まだ録音がありません',
  zh: '暂无语音导览',
};

const ttsLabels: Record<string, string> = {
  kr: '텍스트 읽기',
  en: 'Read aloud',
  ja: '読み上げ',
  zh: '朗读',
};

const loadingMsgs: Record<string, string> = {
  kr: '불러오는 중...',
  en: 'Loading...',
  ja: '読み込み中...',
  zh: '加载中...',
};

const title = titles[lang] || titles.kr;
const noAudioMsg = noAudioMsgs[lang] || noAudioMsgs.kr;
const ttsLabel = ttsLabels[lang] || ttsLabels.kr;
const loadingMsg = loadingMsgs[lang] || loadingMsgs.kr;
---

<div
  class="audio-guide"
  data-asno={asno}
  data-ctcd={ctcd}
  data-kdcd={kdcd}
  data-lang={lang}
  data-title={title}
  data-no-msg={noAudioMsg}
  data-tts-label={ttsLabel}
  data-loading-msg={loadingMsg}
  data-explanation={explanation}
>
  <div class="ag-glow"></div>

  <div class="ag-header">
    <div class="ag-title-row">
      <span class="ag-icon">🎧</span>
      <span class="ag-label">{title}</span>
    </div>
    <div class="ag-building-name">{name}</div>
  </div>

  <div class="ag-body">
    <div class="ag-loading" aria-live="polite">{loadingMsg}</div>

    <div class="ag-player" hidden>
      <button class="ag-play-btn" type="button" aria-label="Play">
        <svg class="ag-icon-play" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <svg class="ag-icon-pause" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" hidden>
          <path d="M6 4h4v16H6zM14 4h4v16h-4z"/>
        </svg>
      </button>
      <div class="ag-controls">
        <div class="ag-progress-track" role="slider" tabindex="0" aria-label="Audio progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <div class="ag-progress-fill"></div>
          <div class="ag-progress-thumb"></div>
        </div>
        <div class="ag-time">
          <span class="ag-time-current">0:00</span>
          <span class="ag-time-sep">/</span>
          <span class="ag-time-total">0:00</span>
        </div>
      </div>
    </div>

    <div class="ag-empty" hidden>
      <svg class="ag-empty-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18V5l12-2v13"/>
        <circle cx="6" cy="18" r="3"/>
        <circle cx="18" cy="16" r="3"/>
      </svg>
      <p class="ag-empty-msg">{noAudioMsg}</p>
      <button class="ag-tts-btn" type="button" hidden>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 5L6 9H2v6h4l5 4V5z"/>
          <line x1="19" y1="9" x2="19" y2="15"/>
          <line x1="22" y1="11" x2="22" y2="13"/>
        </svg>
        {ttsLabel}
      </button>
    </div>
  </div>

  <div class="ag-langs">
    <button class="ag-lang-btn" data-lang="kr" type="button" aria-pressed="false">KR</button>
    <button class="ag-lang-btn" data-lang="en" type="button" aria-pressed="false">EN</button>
    <button class="ag-lang-btn" data-lang="ja" type="button" aria-pressed="false">JA</button>
    <button class="ag-lang-btn" data-lang="zh" type="button" aria-pressed="false">ZH</button>
  </div>
</div>

<script>
(function () {
  const ROOTS = document.querySelectorAll('.audio-guide');

  // ── Singleton ──
  const AG = (window.__AG = window.__AG || { currentAudio: null, currentRoot: null, currentUtter: null });

  function init(root) {
    const asno = root.dataset.asno || '';
    const ctcd = root.dataset.ctcd || '11';
    const kdcd = root.dataset.kdcd || '11';
    const initLang = root.dataset.lang || 'kr';
    let rawExplanation;
    try { rawExplanation = JSON.parse(root.dataset.explanation || '{}'); } catch { rawExplanation = {}; }

    const loadingEl = root.querySelector('.ag-loading');
    const playerEl = root.querySelector('.ag-player');
    const emptyEl = root.querySelector('.ag-empty');
    const ttsBtn = root.querySelector('.ag-tts-btn');
    const playBtn = root.querySelector('.ag-play-btn');
    const iconPlay = root.querySelector('.ag-icon-play');
    const iconPause = root.querySelector('.ag-icon-pause');
    const progressTrack = root.querySelector('.ag-progress-track');
    const progressFill = root.querySelector('.ag-progress-fill');
    const progressThumb = root.querySelector('.ag-progress-thumb');
    const timeCurrent = root.querySelector('.ag-time-current');
    const timeTotal = root.querySelector('.ag-time-total');
    const langBtns = root.querySelectorAll('.ag-lang-btn');

    const cache = new Map();
    let audio = null;
    let isTtsMode = false;
    let currentLang = initLang;
    let isSeeking = false;

    // TTS vars
    let ttsUtterance = null;
    let ttsTimer = null;
    let ttsDuration = 0;
    let ttsElapsed = 0;

    function pauseOther() {
      if (AG.currentAudio && AG.currentRoot !== root) {
        AG.currentAudio.pause();
        const otherRoot = AG.currentRoot;
        if (otherRoot) {
          const op = otherRoot.querySelector('.ag-icon-play');
          const op2 = otherRoot.querySelector('.ag-icon-pause');
          if (op) op.hidden = false;
          if (op2) op2.hidden = true;
        }
      }
      if (AG.currentUtter && AG.currentRoot !== root) {
        window.speechSynthesis.cancel();
        AG.currentUtter = null;
        if (AG.currentRoot) {
          const op = AG.currentRoot.querySelector('.ag-icon-play');
          const op2 = AG.currentRoot.querySelector('.ag-icon-pause');
          if (op) op.hidden = false;
          if (op2) op2.hidden = true;
        }
      }
    }

    function fmt(s) {
      const m = Math.floor(s / 60);
      const sec = Math.floor(s % 60);
      return m + ':' + (sec < 10 ? '0' : '') + sec;
    }

    function showState(state) {
      loadingEl.hidden = state !== 'loading';
      playerEl.hidden = state !== 'player';
      emptyEl.hidden = state !== 'empty';
    }

    function setActiveLang(lang) {
      langBtns.forEach(function (btn) {
        var active = btn.dataset.lang === lang;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-pressed', String(active));
      });
    }

    function resetPlayerUI() {
      iconPlay.hidden = false;
      iconPause.hidden = true;
      playBtn.setAttribute('aria-label', 'Play');
      progressFill.style.width = '0%';
      if (progressThumb) progressThumb.style.left = '0%';
      timeCurrent.textContent = '0:00';
      if (timeTotal) timeTotal.textContent = '0:00';
    }

    // ── API fetch ──
    async function fetchUrl(lang) {
      if (cache.has(lang)) return cache.get(lang) ?? null;
      var apiUrl = '/api/narration?asno=' + encodeURIComponent(asno) + '&ctcd=' + encodeURIComponent(ctcd) + '&kdcd=' + encodeURIComponent(kdcd) + '&gbn=' + encodeURIComponent(lang);
      try {
        var res = await fetch(apiUrl);
        if (!res.ok) { cache.set(lang, null); return null; }
        var data = await res.json();
        var items = data.items || [];
        var url = items.length > 0 ? items[0].url : null;
        cache.set(lang, url);
        return url;
      } catch (e) {
        cache.set(lang, null);
        return null;
      }
    }

    // ── Audio player ──
    function setupAudio(url) {
      if (audio) {
        audio.pause();
        audio.src = '';
        audio.load();
      }
      audio = new Audio(url);
      audio.preload = 'metadata';

      audio.addEventListener('loadedmetadata', function () {
        timeTotal.textContent = fmt(audio.duration);
        progressTrack.setAttribute('aria-valuemax', String(Math.floor(audio.duration)));
      });

      audio.addEventListener('timeupdate', function () {
        if (!audio || isSeeking) return;
        var pct = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
        progressFill.style.width = pct + '%';
        if (progressThumb) progressThumb.style.left = pct + '%';
        timeCurrent.textContent = fmt(audio.currentTime);
        progressTrack.setAttribute('aria-valuenow', String(Math.floor(pct)));
      });

      audio.addEventListener('ended', function () {
        resetPlayerUI();
        AG.currentAudio = null;
        AG.currentRoot = null;
      });

      audio.addEventListener('error', function () {
        audio = null;
        showState('empty');
      });
    }

    // ── TTS player ──
    function getTTSVoice(lang) {
      var voices = window.speechSynthesis.getVoices();
      var langMap = { kr: 'ko-KR', en: 'en-US', ja: 'ja-JP', zh: 'zh-CN' };
      var target = langMap[lang] || 'ko-KR';
      for (var i = 0; i < voices.length; i++) {
        if (voices[i].lang && voices[i].lang.startsWith(target)) return voices[i];
      }
      // Fallback: any Korean voice, then any voice at all
      for (var j = 0; j < voices.length; j++) {
        if (voices[j].lang && voices[j].lang.startsWith('ko')) return voices[j];
      }
      return voices[0] || null;
    }

    function getLangText(lang) {
      // Support both { kr, en, ja, zh } and { explanationKr, ... } shapes
      var text = rawExplanation[lang] || rawExplanation['explanation' + lang.charAt(0).toUpperCase() + lang.slice(1)] || '';
      // Remove \r\n line breaks that hurt TTS flow
      return text.replace(/[\r\n]+/g, ' ').trim();
    }

    function startTTS(lang) {
      var text = getLangText(lang);
      if (!text) { showState('empty'); return; }

      pauseOther();

      if (ttsUtterance) {
        window.speechSynthesis.cancel();
        ttsUtterance = null;
      }

      ttsUtterance = new SpeechSynthesisUtterance(text);
      var voice = getTTSVoice(lang);
      if (voice) ttsUtterance.voice = voice;

      var langMap = { kr: 'ko-KR', en: 'en-US', ja: 'ja-JP', zh: 'zh-CN' };
      ttsUtterance.lang = langMap[lang] || 'ko-KR';
      ttsUtterance.rate = 0.9;

      var wordCount = text.split(/\s+/).length;
      ttsDuration = Math.max(wordCount * 0.25, 10);
      ttsElapsed = 0;
      isTtsMode = true;

      if (audio) { audio.pause(); audio = null; }

      iconPlay.hidden = true;
      iconPause.hidden = false;
      playBtn.setAttribute('aria-label', 'Pause');
      timeTotal.textContent = fmt(ttsDuration);
      AG.currentUtter = ttsUtterance;
      AG.currentRoot = root;

      if (ttsTimer) clearInterval(ttsTimer);
      ttsTimer = setInterval(function () {
        ttsElapsed += 0.25;
        if (ttsElapsed > ttsDuration) ttsElapsed = ttsDuration;
        var pct = (ttsElapsed / ttsDuration) * 100;
        progressFill.style.width = pct + '%';
        if (progressThumb) progressThumb.style.left = pct + '%';
        timeCurrent.textContent = fmt(ttsElapsed);
        progressTrack.setAttribute('aria-valuenow', String(Math.floor(pct)));
      }, 250);

      ttsUtterance.onend = function () {
        if (ttsTimer) clearInterval(ttsTimer);
        resetPlayerUI();
        isTtsMode = false;
        ttsUtterance = null;
        AG.currentUtter = null;
        AG.currentRoot = null;
      };

      ttsUtterance.onerror = function () {
        if (ttsTimer) clearInterval(ttsTimer);
        resetPlayerUI();
        isTtsMode = false;
        ttsUtterance = null;
        AG.currentUtter = null;
      };

      window.speechSynthesis.speak(ttsUtterance);
      showState('player');
      setActiveLang(lang);
      currentLang = lang;
    }

    // ── loadLang (orchestrator) ──
    async function loadLang(lang) {
      showState('loading');

      if (ttsUtterance) {
        window.speechSynthesis.cancel();
        if (ttsTimer) clearInterval(ttsTimer);
        ttsUtterance = null;
        isTtsMode = false;
      }

      var url = await fetchUrl(lang);
      if (url) {
        isTtsMode = false;
        setupAudio(url);
        showState('player');
        setActiveLang(lang);
        currentLang = lang;
        return;
      }

      // Fallback to TTS if explanation text exists
      var text = getLangText(lang);
      if (text) {
        console.warn('[AudioGuide] No narration audio for asno=' + asno + ' lang=' + lang + ' — falling back to TTS');
        ttsBtn.hidden = false;
        showState('empty');
      } else {
        ttsBtn.hidden = true;
        showState('empty');
      }

      setActiveLang(lang);
      currentLang = lang;
    }

    function togglePlay() {
      if (isTtsMode) {
        if (window.speechSynthesis.speaking) {
          if (window.speechSynthesis.paused) {
            window.speechSynthesis.resume();
            iconPlay.hidden = true;
            iconPause.hidden = false;
            if (ttsTimer) clearInterval(ttsTimer);
            ttsTimer = setInterval(function () {
              ttsElapsed += 0.25;
              if (ttsElapsed > ttsDuration) ttsElapsed = ttsDuration;
              var pct = (ttsElapsed / ttsDuration) * 100;
              progressFill.style.width = pct + '%';
              if (progressThumb) progressThumb.style.left = pct + '%';
              timeCurrent.textContent = fmt(ttsElapsed);
            }, 250);
          } else {
            window.speechSynthesis.pause();
            iconPlay.hidden = false;
            iconPause.hidden = true;
            if (ttsTimer) clearInterval(ttsTimer);
          }
        } else {
          startTTS(currentLang);
        }
        return;
      }

      if (!audio) return;

      if (audio.paused) {
        pauseOther();
        audio.play().catch(function () {});
        iconPlay.hidden = true;
        iconPause.hidden = false;
        playBtn.setAttribute('aria-label', 'Pause');
        AG.currentAudio = audio;
        AG.currentRoot = root;
      } else {
        audio.pause();
        iconPlay.hidden = false;
        iconPause.hidden = true;
        playBtn.setAttribute('aria-label', 'Play');
        AG.currentAudio = null;
        AG.currentRoot = null;
      }
    }

    function seek(clientX) {
      if (!audio || isTtsMode) return;
      var rect = progressTrack.getBoundingClientRect();
      var pct = (clientX - rect.left) / rect.width;
      pct = Math.max(0, Math.min(1, pct));
      if (audio.duration) {
        audio.currentTime = pct * audio.duration;
      }
    }

    // ── Events ──
    playBtn.addEventListener('click', togglePlay);

    playBtn.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        togglePlay();
      }
    });

    progressTrack.addEventListener('mousedown', function (e) {
      isSeeking = true;
      seek(e.clientX);
    });
    window.addEventListener('mousemove', function (e) {
      if (!isSeeking) return;
      seek(e.clientX);
    });
    window.addEventListener('mouseup', function () {
      isSeeking = false;
    });

    progressTrack.addEventListener('touchstart', function (e) {
      isSeeking = true;
      seek(e.touches[0].clientX);
    }, { passive: true });
    window.addEventListener('touchmove', function (e) {
      if (!isSeeking) return;
      seek(e.touches[0].clientX);
    }, { passive: true });
    window.addEventListener('touchend', function () {
      isSeeking = false;
    });

    progressTrack.addEventListener('keydown', function (e) {
      if (!audio || isTtsMode) return;
      var step = audio.duration ? audio.duration * 0.05 : 5;
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        audio.currentTime = Math.min(audio.currentTime + step, audio.duration || Infinity);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        audio.currentTime = Math.max(audio.currentTime - step, 0);
      }
    });

    langBtns.forEach(function (btn) {
      btn.addEventListener('click', async function () {
        var lang = btn.dataset.lang;
        if (!lang || lang === currentLang) return;
        await loadLang(lang);
      });
    });

    ttsBtn.addEventListener('click', function () {
      startTTS(currentLang);
    });

    // ── Init ──
    // Pre-load voices
    if (window.speechSynthesis) {
      window.speechSynthesis.getVoices();
      window.speechSynthesis.onvoiceschanged = function () {
        window.speechSynthesis.getVoices();
      };
    }

    setActiveLang(initLang);
    loadLang(initLang);
  }

  ROOTS.forEach(init);
})();
</script>

<style>
  .audio-guide {
    position: relative;
    overflow: hidden;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: 24px;
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .audio-guide:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .ag-glow {
    position: absolute;
    top: -50%;
    right: -30%;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(168, 208, 230, 0.12) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .ag-header {
    position: relative;
    z-index: 1;
    margin-bottom: 20px;
  }

  .ag-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }

  .ag-icon {
    font-size: 1.2rem;
    line-height: 1;
  }

  .ag-label {
    font-family: 'Noto Serif KR', serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .ag-building-name {
    font-size: 0.85rem;
    color: var(--color-text-light);
    padding-left: 28px;
  }

  /* ── Body ── */
  .ag-body {
    position: relative;
    z-index: 1;
    min-height: 80px;
    display: flex;
    align-items: center;
  }

  /* ── Loading ── */
  .ag-loading {
    width: 100%;
    text-align: center;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    padding: 16px 0;
    animation: ag-pulse 1.5s ease-in-out infinite;
  }

  @keyframes ag-pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.8; }
  }

  /* ── Player ── */
  .ag-player {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ag-play-btn {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: none;
    background: var(--color-primary);
    color: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform var(--transition), box-shadow var(--transition);
    box-shadow: var(--shadow-sm);
    -webkit-tap-highlight-color: transparent;
    position: relative;
  }

  .ag-play-btn:hover {
    transform: scale(1.08);
    box-shadow: var(--shadow-md);
  }

  .ag-play-btn:active {
    transform: scale(0.95);
  }

  .ag-play-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .ag-play-btn svg {
    transition: transform var(--transition);
  }

  .ag-controls {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ag-progress-track {
    position: relative;
    width: 100%;
    height: 6px;
    background: var(--color-border-light);
    border-radius: 3px;
    cursor: pointer;
    touch-action: none;
  }

  .ag-progress-track:hover {
    height: 8px;
  }

  .ag-progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: var(--color-primary);
    border-radius: 3px;
    width: 0%;
    transition: width 0.1s linear;
    pointer-events: none;
  }

  .ag-progress-thumb {
    position: absolute;
    top: 50%;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: var(--shadow-sm);
    transform: translate(-50%, -50%);
    left: 0%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .ag-progress-track:hover .ag-progress-thumb {
    opacity: 1;
  }

  .ag-time {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .ag-time-sep {
    color: var(--color-border);
  }

  /* ── Empty ── */
  .ag-empty {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 12px 0;
  }

  .ag-empty-icon {
    color: var(--color-text-muted);
    opacity: 0.5;
  }

  .ag-empty-msg {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  .ag-tts-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    padding: 8px 20px;
    border-radius: 24px;
    border: 1px solid var(--color-primary);
    background: transparent;
    color: var(--color-primary);
    font-family: 'Pretendard', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition);
    -webkit-tap-highlight-color: transparent;
  }

  .ag-tts-btn:hover {
    background: var(--color-primary);
    color: var(--color-text);
    box-shadow: var(--shadow-sm);
  }

  .ag-tts-btn:active {
    transform: scale(0.97);
  }

  /* ── Language Buttons ── */
  .ag-langs {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 8px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border-light);
  }

  .ag-lang-btn {
    font-family: 'Pretendard', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 14px;
    border-radius: 20px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
