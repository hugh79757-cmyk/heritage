---
interface Props {
  name: string;
  nameH?: string;
  desc: string;
  image: string;
  href: string;
  color?: string; // accent color var (e.g., var(--dancheong-red-pastel))
  lang?: string;
  size?: 'default' | 'large';
}

const {
  name,
  nameH = '',
  desc,
  image,
  href,
  color = 'var(--dancheong-red-pastel)',
  lang = 'kr',
  size = 'default',
} = Astro.props;
---
<a href={href} class="card-base card-block" style={{ '--accent': color }}>
  <div class="card-image">
    <img src={image} alt={name} loading="lazy" width="400" height="260" />
  </div>
  <div class="card-content">
    {nameH && <span class="dancheong-hanja">{nameH}</span>}
    <h3 class="dancheong-name">{name}</h3>
    <p class="dancheong-desc">{desc}</p>
  </div>
</a>

<style>
  /* Reuse variables for consistency */
  :root {
    --dancheong-hanja-color: var(--color-text);
    --dancheong-name-color: var(--color-text);
    --dancheong-desc-color: var(--color-text-light);
  }

  .dancheong-hanja {
    display: inline-block;
    font-family: 'Noto Serif KR', serif;
    font-size: 0.75rem;
    color: var(--dancheong-hanja-color);
    margin-bottom: var(--space-1);
    letter-spacing: 0.04em;
  }

  .dancheong-name {
    font-family: 'Noto Serif KR', serif;
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: var(--space-2);
    color: var(--dancheong-name-color);
  }

  .dancheong-desc {
    font-size: 0.9rem;
    color: var(--dancheong-desc-color);
    line-height: 1.6;
  }

  /* Optional hover lift effect using custom property */
  a:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent, var(--color-primary));
  }

  /* Ensure the link fills its container */
  .card-block {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>