---
import GuideLayout from '../components/GuideLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQSection from '../components/FAQSection.astro';
import DancheongCard from '../components/DancheongCard.astro';
import '../styles/global.css';
import { getLang } from '../lib/api';

const lang = getLang(Astro.url);
const htmlLang = lang === 'kr' ? 'ko' : lang;

const title = 'KPop Demon Hunters — Real Seoul Locations Guide | K-Heritage';
const description = 'Complete guide to real Seoul locations featured in KPop Demon Hunters: Gyeongbokgung Palace, Bukchon Hanok Village, Naksan Park, N Seoul Tower, and more. Plan your KPop Demon Hunters pilgrimage in Seoul.';

const faqByLang: Record<string, { question: string; answer: string }[]> = {
  kr: [
    { question: '케이팝 데몬 헌터스는 서울 어디서 촬영했나요?', answer: '경복궁, 북촌한옥마을, 낙산공원, N서울타워 등 실제 서울 명소에서 촬영했습니다.' },
    { question: '촬영지를 직접 방문할 수 있나요?', answer: '네, 모든 촬영지는 일반 관광객이 방문 가능합니다. 경복궁은 입장료가 있으며 사전 예약을 권장합니다.' },
    { question: '하루에 모든 촬영지를 다 볼 수 있나요?', answer: '경복궁→북촌→낙산→N서울타워 순서로 이동하면 하루 코스로 가능합니다.' },
    { question: '케이팝 데몬 헌터스 성지순례 투어가 있나요?', answer: '공식 투어는 없지만 이 페이지의 지도와 루트를 참고해 자유여행으로 방문하실 수 있습니다.' },
    { question: '어떤 궁궐이 가장 많이 나오나요?', answer: '경복궁이 주요 결전 장소로 가장 많이 등장하며, 특히 근정전과 경회루 장면이 인상적입니다.' },
  ],
  en: [
    { question: 'Where was KPop Demon Hunters filmed in Seoul?', answer: 'Key filming locations include Gyeongbokgung Palace, Bukchon Hanok Village, Naksan Park (Seoul City Wall), N Seoul Tower, Gwanghwamun Square, and Insadong. Each location features prominently in specific scenes of the film.' },
    { question: 'Can I visit the KPop Demon Hunters filming locations?', answer: 'Yes! All featured locations are publicly accessible in Seoul. Gyeongbokgung and other palaces require admission (₩3,000 adults). Most outdoor locations like Bukchon, Naksan Park, and Gwanghwamun Square are free to visit.' },
    { question: 'How do I plan a KPop Demon Hunters pilgrimage route?', answer: 'Start at Gyeongbokgung Palace (main setting), walk through Gwanghwamun Square, continue to Bukchon Hanok Village, then hike Naksan Park along the Seoul City Wall. End at N Seoul Tower for the night view. This route takes a full day.' },
    { question: 'Is there a KPop Demon Hunters tour in Seoul?', answer: 'While no official tour exists yet, the locations are spread across central Seoul and easily accessible by subway. This guide provides a self-guided pilgrimage route with all the key spots marked on a map.' },
    { question: 'What palace is featured most in KPop Demon Hunters?', answer: 'Gyeongbokgung Palace is the primary setting, with several key scenes filmed at Geunjeongjeon (Throne Hall) and the palace grounds. The film showcases the palace at night with dramatic lighting.' },
  ],
  ja: [
    { question: 'KPop Demon Huntersのソウルのロケ地はどこですか？', answer: '景福宮、北村韓屋村、駱山公園、Nソウルタワーなど、ソウルの実際の名所で撮影されました。' },
    { question: 'ロケ地に直接訪問できますか？', answer: 'はい、すべてのロケ地は一般観光客が訪問可能です。景福宮は入場料がかかり、事前予約を推奨します。' },
    { question: '一日ですべてのロケ地を見ることができますか？', answer: '景福宮→北村→駱山→Nソウルタワーの順で移動すれば、一日コースで可能です。' },
    { question: 'KPop Demon Huntersの聖地巡礼ツアーはありますか？', answer: '公式ツアーはありませんが、このページの地図とルートを参考に自由旅行で訪問できます。' },
    { question: '最も多く登場する宮殿はどこですか？', answer: '景福宮が主な決戦場所として最も多く登場し、特に勤政殿と慶會樓のシーンが印象的です。' },
  ],
  zh: [
    { question: 'KPop Demon Hunters在首尔哪里拍摄的？', answer: '在景福宫、北村韩屋村、骆山公园、N首尔塔等首尔实际名胜拍摄。' },
    { question: '可以亲自参观拍摄地吗？', answer: '可以，所有拍摄地都对普通游客开放。景福宫需要门票，建议提前预约。' },
    { question: '一天能看完所有拍摄地吗？', answer: '按景福宫→北村→骆山→N首尔塔的顺序移动，一天行程可以完成。' },
    { question: '有KPop Demon Hunters的圣地巡礼团吗？', answer: '没有官方旅行团，但可以参考本页面的地图和路线自由行参观。' },
    { question: '哪个宫殿出场最多？', answer: '景福宫作为主要决战场地出场最多，特别是勤政殿和庆会楼的场景令人印象深刻。' },
  ],
};

const faqItems = faqByLang[lang] || faqByLang.en;

const locations = [
  {
    id: 'gyeongbokgung',
    name: { en: 'Gyeongbokgung Palace', kr: '경복궁', ja: '景福宮', zh: '景福宫' },
    hanja: { en: 'Gyeongbokgung', kr: '景福宮' },
    desc: { en: 'The primary setting — where the main confrontation unfolds beneath the throne hall under moonlight.', kr: '주요 배경 — 달빛 아래 전각에서 벌어지는 주요 결전 장소.', ja: '主要舞台 — 月明の下で本殿前で繰り広げられる主要な対決の場所。', zh: '主要场景 — 月光下大殿前展开的主要对决之地。' },
    image: '/tour-images/gyeongbokgung.jpg',
    link: '/palace/1',
    guideLink: '/guide/gyeongbokgung',
    type: 'palace',
    coords: '37.5796, 126.9770',
  },
  {
    id: 'bukchon',
    name: { en: 'Bukchon Hanok Village', kr: '북촌한옥마을', ja: '北村韓屋村', zh: '北村韩屋村' },
    hanja: { en: 'Bukchon', kr: '北村' },
    desc: { en: 'The chase scene through narrow hanok alleyways — one of the most iconic sequences in the film.', kr: '좁은 한옥 골목을 질주하는 추격 장면 — 영화에서 가장 상징적인 시퀀스 중 하나.', ja: '狭い韓屋路地を駆け抜ける追逐シーン — 映画で最も象徴的なシークエンスの一つ。', zh: '穿过狭窄韩屋小巷的追逐场景 — 电影中最具标志性的场景之一。' },
    image: '/tour-images/bukchon.jpg',
    link: '#',
    guideLink: '#',
    type: 'scenic',
    coords: '37.5826, 126.9857',
  },
  {
    id: 'naksan',
    name: { en: 'Naksan Park / Seoul City Wall', kr: '낙산공원 / 한양도성', ja: '駱山公園 / 漢陽都城', zh: '骆山公园 / 汉阳都城' },
    hanja: { en: 'Naksan', kr: '駱山' },
    desc: { en: 'The rooftop chase along the ancient fortress wall — where tradition meets the modern skyline.', kr: '고대 성곽을 따라 지붕 위를 달리는 추격 장면 — 전통과 현대 스카이라인의 만남.', ja: '古代城郭に沿って屋上を駆ける追逐シーン — 伝統と近代スカイラインの出会い。', zh: '沿着古城墙屋顶追逐的场景 — 传统与现代天际线的交汇。' },
    image: '/tour-images/naksan.jpg',
    link: '#',
    guideLink: '#',
    type: 'historic',
    coords: '37.5800, 127.0070',
  },
  {
    id: 'nseoul-tower',
    name: { en: 'N Seoul Tower', kr: 'N서울타워', ja: 'Nソウルタワー', zh: 'N首尔塔' },
    hanja: { en: 'N Seoul Tower', kr: 'N서울타워' },
    desc: { en: 'The climactic rooftop confrontation with Seoul\'s night skyline as backdrop.', kr: '서울 야경을 배경으로 한 클라이맥스 옥상 대결 장면.', ja: 'ソウルの夜景を背景にしたクライマックスの屋上対決シーン。', zh: '以首尔夜景为背景的高潮屋顶对决场景。' },
    image: '/tour-images/nseoul.jpg',
    link: '#',
    guideLink: '#',
    type: 'scenic',
    coords: '37.5512, 126.9882',
  },
  {
    id: 'gwanghwamun',
    name: { en: 'Gwanghwamun Square', kr: '광화문광장', ja: '光化門広場', zh: '光化门广场' },
    hanja: { en: 'Gwanghwamun', kr: '光化門' },
    desc: { en: 'The dramatic opening chase through the historic square — King Sejong\'s statue witnesses the action.', kr: '세종대왕 동상이 지켜보는 역사적 광장에서의 드라마틱한 오프닝 추격 장면.', ja: '世宗大王像が見守る歴史的広場でのドラマチックなオープニング追逐シーン。', zh: '在世宗大王铜像见证下历史广场上的戏剧性开场追逐。' },
    image: '/tour-images/gwanghwamun.jpg',
    link: '#',
    guideLink: '#',
    type: 'scenic',
    coords: '37.5724, 126.9769',
  },
  {
    id: 'insadong',
    name: { en: 'Insadong', kr: '인사동', ja: '仁寺洞', zh: '仁寺洞' },
    hanja: { en: 'Insadong', kr: '仁寺洞' },
    desc: { en: 'The traditional market scene where ancient artifacts become weapons of choice.', kr: '고대 유물이 무기가 되는 전통 시장 장면.', ja: '古代の遺物が武器となる伝統市場のシーン。', zh: '古代文物成为武器的传统市场场景。' },
    image: '/tour-images/insadong.jpg',
    link: '#',
    guideLink: '#',
    type: 'historic',
    coords: '37.5710, 126.9882',
  },
];

function getLocName(loc: typeof locations[0]) {
  const map: Record<string, string> = { kr: loc.name.kr, en: loc.name.en, ja: loc.name.ja, zh: loc.name.zh };
  return map[lang] || loc.name.en;
}
function getLocDesc(loc: typeof locations[0]) {
  const map: Record<string, string> = { kr: loc.desc.kr, en: loc.desc.en, ja: loc.desc.ja, zh: loc.desc.zh };
  return map[lang] || loc.desc.en;
}

const heroTitle: Record<string, string> = {
  en: 'KPop Demon Hunters\nReal Seoul Locations',
  kr: '케이팝 데몬 헌터스\n실제 서울 촬영지',
  ja: 'KPop Demon Hunters\nソウル実際のロケ地',
  zh: 'KPop Demon Hunters\n首尔实际拍摄地',
};
const heroSub: Record<string, string> = {
  en: 'Walk in the footsteps of your favorite characters. Every palace, alley, and rooftop from the film — mapped and guide-ready.',
  kr: '좋아하는 캐릭터의 발자취를 따라가보세요. 영화 속 모든 궁궐, 골목, 옥지도표시와 가이드.',
  ja: 'お気に入りのキャラクターの足跡を辿りましょう。映画のすべての宮殿、路地、屋上をマッピング。',
  zh: '追随你最爱角色的足迹。电影中的每座宫殿、小巷和屋顶都已标注并配有指南。',
};

const sectionTitle: Record<string, string> = {
  en: 'Filming Locations Map',
  kr: '촬영지 지도',
  ja: 'ロケ地マップ',
  zh: '拍摄地地图',
};
const sectionSub: Record<string, string> = {
  en: 'Explore all 6 key locations on the interactive map',
  kr: '인터랙티브 지도에서 6개 핵심 촬영지 탐색',
  ja: 'インタラクティブマップで6つの主要ロケ地を探索',
  zh: '在互动地图上探索6个主要拍摄地点',
};
---
<GuideLayout title={title} description={description} lang={htmlLang}>
  <style>@import '../styles/global.css';</style>

  <!-- 히어로 — 케데헌 네온 시네마틱 -->
  <section class="kdh-hero">
    <div class="kdh-hero-bg">
      <img src="https://www.heritage.go.kr/gung/gogung1/images/ic-e21.jpg" alt="KPop Demon Hunters Seoul" fetchpriority="high" />
    </div>
    <div class="kdh-hero-overlay"></div>
    <div class="kdh-hero-content">
      <span class="kdh-badge">KPop Demon Hunters</span>
      <h1 class="kdh-title neon-text-gold" set:html={heroTitle[lang]?.replace(/\n/g, '<br/>') || heroTitle.en.replace(/\n/g, '<br/>')} />
      <p class="kdh-subtitle">{heroSub[lang] || heroSub.en}</p>
      <div class="kdh-cta">
        <a href="#locations" class="btn btn-primary">{lang === 'kr' ? '촬영지 둘러보기' : lang === 'ja' ? 'ロケ地を見る' : lang === 'zh' ? '查看拍摄地' : 'Explore Locations'} &darr;</a>
        <a href="#map-section" class="btn btn-outline">{lang === 'kr' ? '지도에서 보기' : lang === 'ja' ? '地図で見る' : lang === 'zh' ? '地图查看' : 'View on Map'}</a>
      </div>
    </div>
    <div class="hero-scroll">
      SCROLL
      <div class="hero-scroll-line"></div>
    </div>
  </section>

  <!-- 민화 구분선 (이미지 추가 시 활성화) -->
  <div class="minhwa-divider"></div>

  <div class="container">

    <BreadcrumbNav items={[{ name: 'Home', url: '/' }, { name: 'KPop Demon Hunters' }]} lang={lang} />

    <!-- 지도 섹션 -->
    <section id="map-section" class="kdh-map-section">
      <div class="section-header">
        <h2>{sectionTitle[lang] || sectionTitle.en}</h2>
        <p>{sectionSub[lang] || sectionSub.en}</p>
      </div>
      <div class="kdh-map-wrap" id="kdh-map"></div>

      <!-- 둥둥 카드 슬라이더 -->
      <div class="location-cards-slider" id="locationSlider">
        {locations.map((loc, i) => (
          <div class="location-card-item" style={`--card-index: ${i}`} data-loc-id={loc.id}>
            <span class="lci-dot" style={`background: ${loc.type === 'palace' ? 'var(--palace-gyeongbok)' : loc.type === 'scenic' ? 'var(--neon-gold)' : 'var(--neon-blue)'}`}></span>
            <h4 class="lci-name">{getLocName(loc)}</h4>
            <p class="lci-desc">{getLocDesc(loc).slice(0, 40)}...</p>
          </div>
        ))}
      </div>
    </section>

    <hr class="dancheong-divider" />

    <!-- 촬영지 카드 -->
    <section id="locations">
      <div class="section-header">
        <h2>{lang === 'kr' ? '촬영지 가이드' : lang === 'ja' ? 'ロケ地ガイド' : lang === 'zh' ? '拍摄地指南' : 'Location Guide'}</h2>
        <p>{lang === 'kr' ? '각 장소의 영화 장면과 관람 정보' : lang === 'ja' ? '各場所の映画シーンと観覧情報' : lang === 'zh' ? '各场景的电影情节与参观信息' : 'Film scenes and visitor info for each location'}</p>
      </div>

      <div class="kdh-locations">
        {locations.map((loc, i) => {
          const hasRealLink = loc.guideLink !== '#' || loc.link !== '#';
          const accentColor = loc.type === 'palace' ? 'var(--palace-gyeongbok)' : loc.type === 'scenic' ? 'var(--neon-gold)' : 'var(--neon-blue)';
          if (hasRealLink) {
            return (
              <DancheongCard
                name={getLocName(loc)}
                nameH={loc.hanja?.en || ''}
                desc={getLocDesc(loc)}
                image={loc.image}
                href={`${loc.guideLink !== '#' ? loc.guideLink : loc.link}?lang=${lang}`}
                color={accentColor}
                lang={lang}
              />
            );
          }
          return (
            <div
              class="kdh-loc-card"
              style={`--card-accent: ${accentColor}`}
              data-loc-id={loc.id}
              role="button"
              tabindex="0"
            >
              <div class="kdh-loc-glow"></div>
              <div class="kdh-loc-img">
                <img src={loc.image} alt={getLocName(loc)} loading="lazy" width="400" height="260" />
                <div class="kdh-loc-img-overlay"></div>
                <div class="kdh-loc-bar"></div>
              </div>
              <div class="kdh-loc-body">
                <span class="kdh-loc-hanja">{loc.hanja?.en || ''}</span>
                <h3 class="kdh-loc-name">{getLocName(loc)}</h3>
                <p class="kdh-loc-desc">{getLocDesc(loc)}</p>
              </div>
              <div class="kdh-loc-arrow">&darr;</div>
            </div>
          );
        })}
      </div>
    </section>

    <hr class="dancheong-divider" />

    <!-- 순례 루트 -->
    <section class="kdh-route">
      <div class="section-header">
        <h2>{lang === 'kr' ? '하루 코스 성지순례 루트' : lang === 'ja' ? '一日巡礼ルート' : lang === 'zh' ? '一日巡礼路线' : 'One-Day Pilgrimage Route'}</h2>
      </div>
      <div class="route-timeline">
        <div class="route-step">
          <span class="route-time">09:00</span>
          <div class="route-info">
            <h4>{lang === 'kr' ? '경복궁 입장' : 'Gyeongbokgung Palace'}</h4>
            <p>{lang === 'kr' ? '오전 관람 (가장 한적한 시간)' : 'Morning visit (least crowded)'}</p>
          </div>
        </div>
        <div class="route-step">
          <span class="route-time">11:00</span>
          <div class="route-info">
            <h4>{lang === 'kr' ? '광화문광장' : 'Gwanghwamun Square'}</h4>
            <p>{lang === 'kr' ? '세종대왕·이순신 동상 포토존' : 'Photo spot with King Sejong & Admiral Yi statues'}</p>
          </div>
        </div>
        <div class="route-step">
          <span class="route-time">12:30</span>
          <div class="route-info">
            <h4>{lang === 'kr' ? '인사동 점심' : 'Insadong Lunch'}</h4>
            <p>{lang === 'kr' ? '전통 음식 + 기념품 쇼핑' : 'Traditional food + souvenir shopping'}</p>
          </div>
        </div>
        <div class="route-step">
          <span class="route-time">14:00</span>
          <div class="route-info">
            <h4>{lang === 'kr' ? '북촌한옥마을 산책' : 'Bukchon Hanok Village Walk'}</h4>
            <p>{lang === 'kr' ? '추격 촬영지 골목 탐험' : 'Explore the chase scene alleyways'}</p>
          </div>
        </div>
        <div class="route-step">
          <span class="route-time">16:00</span>
          <div class="route-info">
            <h4>{lang === 'kr' ? '낙산공원 성곽길' : 'Naksan Park Fortress Walk'}</h4>
            <p>{lang === 'kr' ? '한양도성 산책로 + 야경 명소' : 'Seoul City Wall trail + sunset viewpoint'}</p>
          </div>
        </div>
        <div class="route-step">
          <span class="route-time">18:30</span>
          <div class="route-info">
            <h4>{lang === 'kr' ? 'N서울타워 야경' : 'N Seoul Tower Night View'}</h4>
            <p>{lang === 'kr' ? '클라이맥스 촬영지 배경 감상' : 'Climax filming location backdrop'}</p>
          </div>
        </div>
      </div>
    </section>

    <hr class="dancheong-divider" />

    <div class="minhwa-divider-strip">
      <img
        src="/minhwa-tiger-magpie.jpeg"
        alt="민화 호작도"
        width="1200"
        height="200"
        loading="lazy"
      />
    </div>

    <FAQSection items={faqItems} lang={lang} />
  </div>
</GuideLayout>

<script define:vars={{ locationsJSON: JSON.stringify(locations.map(l => ({ id: l.id, name: l.name, desc: l.desc, link: l.link, type: l.type, coords: l.coords.split(', ').map(Number) }))), mapLang: lang }}>
(function() {
  var LOCATIONS = locationsJSON;
  var L = mapLang;
  var markers = [];
  var map = null;

  var popupLabels = {
    kr: '자세히 보기', ja: '詳しく見る', zh: '查看详情', en: 'View Details'
  };

  function getLocName(loc) {
    return loc.name[L] || loc.name.en;
  }
  function getLocDesc(loc) {
    return (loc.desc && loc.desc[L]) || loc.desc.en || '';
  }

  function openPopup(locId) {
    var loc = LOCATIONS.find(function(l) { return l.id === locId; });
    if (!loc || !map) return;
    var m = markers.find(function(m) { return m.locId === locId; });
    if (m) {
      map.flyTo({ center: loc.coords, zoom: 15, duration: 800 });
      setTimeout(function() { m.marker.togglePopup(); }, 900);
    }
  }
  window.openPopup = openPopup;

  function initKDHMap() {
    var mapEl = document.getElementById('kdh-map');
    if (!mapEl) return;

    var script = document.createElement('script');
    script.src = 'https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js';
    script.onload = function() {
      map = new maplibregl.Map({
        container: 'kdh-map',
        style: 'https://tiles.openfreemap.org/styles/liberty',
        center: [126.9769, 37.5760],
        zoom: 14,
        minZoom: 11,
        maxZoom: 18,
        pitch: 30,
        attributionControl: false
      });
      map.addControl(new maplibregl.AttributionControl({ compact: true }), 'bottom-right');

      var iconMap = { palace: '\u{1F3EF}', scenic: '\u{1F3D4}\uFE0F', historic: '\u{1F3DB}\uFE0F' };
      var colorMap = { palace: '#00C8FF', scenic: '#FFD700', historic: '#FF3B5C' };

      LOCATIONS.forEach(function(loc) {
        var color = colorMap[loc.type] || '#FFD700';
        var icon = iconMap[loc.type] || '\u{1F3EF}';

        var el = document.createElement('div');
        el.className = 'map-marker';
        el.innerHTML =
          '<div class="marker-pin" style="--marker-color:' + color + '">' +
            '<span class="marker-icon">' + icon + '</span>' +
          '</div>' +
          '<div class="marker-pulse" style="--marker-color:' + color + '"></div>';

        var popup = new maplibregl.Popup({ offset: 25, className: 'heritage-popup' })
          .setHTML(
            '<div class="popup-inner">' +
              '<h3 class="popup-title">' + getLocName(loc) + '</h3>' +
              '<p class="popup-desc">' + getLocDesc(loc) + '</p>' +
              '<a href="' + loc.link + '" class="popup-link">' + popupLabels[L] + ' &rarr;</a>' +
            '</div>'
          );

        var marker = new maplibregl.Marker({ element: el })
          .setLngLat(loc.coords)
          .setPopup(popup)
          .addTo(map);

        markers.push({ locId: loc.id, marker: marker });
      });

      // 카드 클릭 → 마커 팝업 열기
      document.querySelectorAll('.location-card-item').forEach(function(card) {
        card.addEventListener('click', function() {
          openPopup(card.dataset.locId);
        });
      });

      // 지도 카드 클릭 → 스크롤 후 팝업 열기
      document.querySelectorAll('.kdh-loc-card').forEach(function(card) {
        card.addEventListener('click', function() {
          document.getElementById('map-section').scrollIntoView({ behavior: 'smooth' });
          setTimeout(function() { openPopup(card.dataset.locId); }, 700);
        });
      });
    };
    document.head.appendChild(script);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initKDHMap);
  } else {
    initKDHMap();
  }
})();
</script>

