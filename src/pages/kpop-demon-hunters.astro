<script>
  const locations = [
    { id: 'jamsil', name: { en: 'Jamsil Sports Complex', kr: '서울종합운동장', ja: 'ソウル総合運動場', zh: '首尔综合运动场' }, coords: [127.0780, 37.5196], type: 'scene' },
    { id: 'cheongdam', name: { en: 'Cheongdam Bridge', kr: '청담대교', ja: '清潭橋', zh: '清潭大桥' }, coords: [127.0490, 37.5400], type: 'scene' },
    { id: 'coex', name: { en: 'COEX K-POP Square', kr: 'COEX K-POP 스퀘어', ja: 'COEX K-POPスクエア', zh: 'COEX K-POP广场' }, coords: [127.0586, 37.5120], type: 'scene' },
    { id: 'myeongdong', name: { en: 'Myeongdong Street', kr: '명동거리', ja: '明洞通り', zh: '明洞街' }, coords: [126.9820, 37.5636], type: 'scene' },
    { id: 'bukchon', name: { en: 'Bukchon Hanok Village', kr: '북촌한옥마을', ja: '北村韓屋村', zh: '北村韩屋村' }, coords: [126.9857, 37.5826], type: 'scene' },
    { id: 'naksan', name: { en: 'Naksan Park', kr: '낙산공원', ja: '駱山公園', zh: '骆山公园' }, coords: [127.0070, 37.5800], type: 'scene' },
    { id: 'nseoul-tower', name: { en: 'N Seoul Tower', kr: 'N서울타워', ja: 'Nソウルタワー', zh: 'N首尔塔' }, coords: [126.9882, 37.5512], type: 'scene' },
    { id: 'lotte-world-tower', name: { en: 'Lotte World Tower', kr: '롯데월드타워', ja: 'ロッテワールドタワー', zh: '乐天世界塔' }, coords: [127.0788, 37.5128], type: 'motif' },
    { id: 'gyeongbokgung', name: { en: 'Gyeongbokgung Palace', kr: '경복궁', ja: '景福宮', zh: '景福宫' }, coords: [126.9770, 37.5796], type: 'inspiration' },
  ];

  function getLocName(loc) {
    const map = { kr: loc.name.kr, en: loc.name.en, ja: loc.name.ja, zh: loc.name.zh };
    return map[lang] || loc.name.en;
  }

  document.addEventListener('DOMContentLoaded', function() {
    const mapElement = document.getElementById('kdh-map');
    if (!mapElement) return;

    const script = document.createElement('script');
    script.src = 'https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js';
    script.onload = function() {
      const map = new maplibregl.Map({
        container: 'kdh-map',
        style: 'https://tiles.openfreemap.org/styles/liberty',
        center: [127.03, 37.55],
        zoom: 12,
        minZoom: 11,
        maxZoom: 17,
        pitch: 25,
        attributionControl: false,
        scrollZoom: false
      });

      map.addControl(new maplibregl.AttributionControl({ compact: true }), 'bottom-right');

      const typeColors = { scene: '#E8A020', motif: '#A8D0E6', inspiration: '#C8A2C8' };
      const typeLabels = {
        kr: { scene: '장면 배경', motif: '디자인 모티프', inspiration: '건축적 영감' },
        en: { scene: 'Scene', motif: 'Design Motif', inspiration: 'Architectural Inspiration' },
        ja: { scene: 'シーンの舞台', motif: 'デザイン母題', inspiration: '建築的インスピレーション' },
        zh: { scene: '场景背景', motif: '设计灵感', inspiration: '建筑灵感' },
      };
      const tlabels = typeLabels[lang] || typeLabels.en;

      function buildPopupHTML(loc) {
        const color = typeColors[loc.type] || '#E8A020';
        const typeLabel = tlabels[loc.type] || 'Scene';
        const name = getLocName(loc);
        return `
          <div class="popup-inner">
            <div class="popup-type-badge" style="background:${color}20;color:${color}">${typeLabel}</div>
            <h3 class="popup-title">${name}</h3>
            <a href="/kpop-demon-hunters/${loc.id}?lang=${lang}" class="popup-link">
              ${lang === 'kr' ? '방문 정보 보기 →' : lang === 'ja' ? '訪問情報をみる →' : lang === 'zh' ? '查看参观信息 →' : 'Visit Info →'}
            </a>
          </div>
        `;
      }

      locations.forEach(function(loc) {
        const color = typeColors[loc.type] || '#E8A020';
        const el = document.createElement('div');
        el.className = 'map-marker';
        el.innerHTML = `
          <div class="marker-pin" style="--marker-color: ${color}">
            <span class="marker-icon">${loc.type === 'inspiration' ? '🏯' : loc.type === 'motif' ? '🏢' : '📍'}</span>
          </div>
          <div class="marker-pulse" style="--marker-color: ${color}"></div>
        `;
        const popup = new maplibregl.Popup({ offset: 25, className: 'heritage-popup' }).setHTML(buildPopupHTML(loc));
        new maplibregl.Marker({ element: el })
          .setLngLat(loc.coords)
          .setPopup(popup)
          .addTo(map);
      });

      // Route line connecting main 7 scenes in order
      const routeCoords = [
        [127.0780, 37.5196], // jamsil
        [127.0586, 37.5120], // coex
        [127.0490, 37.5400], // cheongdam
        [126.9820, 37.5636], // myeongdong
        [126.9857, 37.5826], // bukchon
        [127.0070, 37.5800], // naksan
        [126.9882, 37.5512], // nseoul-tower
      ];

      map.addSource('kdh-route', {
        type: 'geojson',
        data: {
          type: 'Feature',
          properties: {},
          geometry: { type: 'LineString', coordinates: routeCoords }
        }
      });

      map.addLayer({
        id: 'kdh-route-line',
        type: 'line',
        source: 'kdh-route',
        layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: {
          'line-color': '#A8D0E6',
          'line-width': 2.5,
          'line-opacity': 0.45,
          'line-dasharray': [4, 5]
        }
      });

      // Card click -> fly to location
      document.querySelectorAll('.location-card-item').forEach(function(card) {
        card.addEventListener('click', function() {
          const locId = this.dataset.locId;
          const loc = locations.find(l => l.id === locId);
          if (loc) {
            map.flyTo({ center: loc.coords, zoom: 16, duration: 800 });
            // Open popup after fly
            setTimeout(() => {
              const markers = document.querySelectorAll('.map-marker');
              markers.forEach(m => {
                const inner = m.querySelector('.marker-icon');
                if (inner && m.parentElement && m.parentElement.getAttribute('data-loc-id') === locId) {
                  // trigger popup via maplibre API — closest approach
                }
              });
            }, 900);
          }
        });
      });

      // Store locId on each marker element for navigation
      map.on('load', function() {
        // After markers added, attach data attributes
        setTimeout(() => {
          document.querySelectorAll('.map-marker').forEach((markerEl, i) => {
            if (locations[i]) markerEl.setAttribute('data-loc-id', locations[i].id);
          });
        }, 500);
      });
    };
    document.head.appendChild(script);
  });
</script>

