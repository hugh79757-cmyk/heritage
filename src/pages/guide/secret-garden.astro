---
import GuideLayout from '../../components/GuideLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import FAQSection from '../../components/FAQSection.astro';
import '../../styles/global.css';
import { getLang } from '../../lib/api';

const lang = getLang(Astro.url);
const htmlLang = lang === 'kr' ? 'ko' : lang;

const title = 'Changdeokgung Secret Garden Complete Guide 2026 | K-Heritage';
const description = 'Complete guide to Changdeokgung Secret Garden (비원/Huwon): reservation tips, tour schedules, must-see spots, best seasons, and how to book tickets for 2026.';

const faqByLang: Record<string, { question: string; answer: string }[]> = {
  kr: [
    { question: "이 내용은 아직 준비 중입니다", answer: "영어 버전을 참조해주세요." },
  ],
  en: [
  { question: 'How do I reserve Secret Garden tickets?', answer: 'Book through the Korea Heritage Service website (heritage.go.kr). Reservations open on the 1st of each month for the following month. Tickets sell out within hours — set a reminder and book as soon as they become available.' },
  { question: 'What are the Secret Garden tour times?', answer: 'Guided tours run daily at 10:00, 11:00, 14:00, and 15:30. Each tour accommodates approximately 100 visitors and lasts about 90 minutes. The tour follows a fixed route through the garden.' },
  { question: 'How much is the Secret Garden ticket?', answer: 'Combined palace + Secret Garden: ₩8,000 (adults), ₩4,000 (youth). Secret Garden only: ₩5,000 (adults), ₩2,500 (youth). Children under 7 and seniors 65+ are free.' },
  { question: 'What will I see in the Secret Garden?', answer: 'The 78-acre garden features Buyongji Pond, Juhamnu Pavilion (royal library), Ongnyucheon Stream (where nobles composed poetry), Seonhyeongjeong Pavilion, and the Yeongyeongdang residence. Each season reveals different beauty.' },
  { question: 'What is the best season for the Secret Garden?', answer: 'Autumn (mid-October to late November) is universally considered the most spectacular, with vibrant red and gold foliage reflected in the ponds. Spring cherry blossoms (April) are also stunning. Summer offers lush greenery and lotus flowers.' },
  { question: 'Can I enter the Secret Garden without a tour?', answer: 'No, independent exploration is not permitted. All visitors must join a guided tour at the designated times. This policy protects the delicate garden ecosystem and historical structures.' },
],
};
const faqItems = faqByLang[lang] || faqByLang.en;

const h: Record<string, any> = {
  en: {
    h1: 'Changdeokgung Secret Garden Complete Guide 2026',
    intro: 'The Secret Garden (비원/Huwon) of Changdeokgung Palace is a 78-acre masterpiece of Korean landscape design, featuring pavilions, ponds, streams, and ancient trees that have witnessed over 400 years of history. Designated as part of the UNESCO World Heritage site in 1997, it is considered one of the finest examples of traditional Korean garden design, blending harmoniously with the natural topography.',
    h2_1: 'Reservation System — How to Book',
    h2_2: 'Tour Schedule & Duration',
    h2_3: 'Ticket Prices',
    h2_4: 'Must-See Spots in the Garden',
    h2_5: 'Best Season to Visit',
    h2_6: 'Visitor Tips',
    cta: 'Explore Changdeokgung buildings →',
  },
  kr: {
    h1: '창덕궁 비원 완전 가이드 2026',
    intro: '창덕궁 비원(후원)은 78에이커 규모의 한국 정원 디자인 걸작으로, 누각, 연못, 계곡, 오래된 나무가 400년 이상의 역사를 간직하고 있습니다. 1997년 UNESCO 세계유산으로 지정된 이곳은 자연 지형과 조화를 이룬 한국 전통 정원의 대표적 예시입니다.',
    h2_1: '예약 방법',
    h2_2: '투어 일정 및 소요시간',
    h2_3: '입장료',
    h2_4: '비원 주요 볼거리',
    h2_5: '최적 관람 시즌',
    h2_6: '관람 팁',
    cta: '창덕궁 건물 전체 보기 →',
  },
  ja: {
    h1: '昌德宮秘苑 完全ガイド 2026',
    intro: '昌德宮秘苑（后園）は78エーカーの韓国庭園デザインの傑作で、亭閣、池、渓流、古木が400年以上の歴史を伝えています。1997年にUNESCO世界遺産に指定され、自然の地形と調和した韓国庭園の最高傑作とされています。',
    h2_1: '予約方法',
    h2_2: 'ツアー日程と所要時間',
    h2_3: '入場料',
    h2_4: '秘苑の見どころ',
    h2_5: 'ベストシーズン',
    h2_6: '観光ヒント',
    cta: '昌德宮の全建築物を見る →',
  },
  zh: {
    h1: '昌德宫秘苑完全指南 2026',
    intro: '昌德宫秘苑（后苑）是一个78英亩的韩国园林设计杰作，亭阁、池塘、溪流和古树见证了400多年的历史。1997年被列入UNESCO世界遗产，被誉为与自然地形和谐融合的韩国传统园林设计典范。',
    h2_1: '预约方法',
    h2_2: '导览日程与时长',
    h2_3: '门票价格',
    h2_4: '秘苑主要看点',
    h2_5: '最佳游览季节',
    h2_6: '游客贴士',
    cta: '查看昌德宫全部建筑 →',
  },
};

const t = h[lang] || h.en;
---
<GuideLayout title={title} description={description} lang={htmlLang}>
  <style>@import '../../styles/global.css';</style>
  <div class="container">
    <BreadcrumbNav items={[{ name: 'Home', url: '/' }, { name: 'Guide', url: '/guide' }, { name: 'Secret Garden' }]} lang={lang} />
    <article class="guide-content">
      <h1>{t.h1}</h1>
      <p class="guide-meta">Updated: June 2026 &middot; Korea Heritage Service official data</p>
      <img class="guide-hero-img" src="https://www.heritage.go.kr/gung/gogung2/images/img_changdeok_story_bg_00_00.jpg" alt="Changdeokgung Secret Garden" width="960" height="400" />
      <p class="guide-intro">{t.intro}</p>

      <h2>{t.h2_1}</h2>
      <p>The Secret Garden requires advance reservation — you cannot simply walk in. Tickets are released on the <strong>1st of each month</strong> for the following month on the Korea Heritage Service website (heritage.go.kr).</p>
      <div class="info-box tip-box">
        <ul>
          <li><strong>When:</strong> 1st of each month, typically at midnight KST</li>
          <li><strong>Where:</strong> heritage.go.kr → Changdeokgung → Secret Garden</li>
          <li><strong>How fast:</strong> Tickets sell out within 1-2 hours, sometimes minutes</li>
          <li><strong>Tip:</strong> Set an alarm for the 1st and book immediately. Weekday morning tours sell slower than weekends.</li>
        </ul>
      </div>

      <h2>{t.h2_2}</h2>
      <div class="info-box"><p><strong>Daily tours:</strong> 10:00, 11:00, 14:00, 15:30<br/><strong>Duration:</strong> Approximately 90 minutes<br/><strong>Group size:</strong> ~100 visitors per tour<br/><strong>Route:</strong> Fixed (entering through Donhwamun Gate, exiting via the rear)</p></div>

      <h2>{t.h2_3}</h2>
      <div class="info-box">
        <p><strong>Palace + Secret Garden (Combined):</strong><br/>Adults: ₩8,000 &middot; Youth: ₩4,000</p>
        <p><strong>Secret Garden Only:</strong><br/>Adults: ₩5,000 &middot; Youth: ₩2,500</p>
        <p>Children under 7 and seniors 65+: Free</p>
      </div>

      <h2>{t.h2_4}</h2>
      <p>The garden features several iconic locations:</p>
      <ul class="spot-list">
        <li><strong>Buyongji Pond (芙蓉池):</strong> A square pond symbolizing the king's realm, surrounded by lotus flowers in summer</li>
        <li><strong>Juhamnu Pavilion (宙合楼):</strong> The royal library overlooking Buyongji, used for studying Confucian classics</li>
        <li><strong>Ongnyucheon (玉流川):</strong> A stream where court nobles gathered to compose poetry, dropping floating wine cups downstream</li>
        <li><strong>Seonhyeongjeong Pavilion (璇源亭):</strong> A rustic retreat surrounded by dense forest</li>
        <li><strong>Yeongyeongdang (養性堂):</strong> The king's private residence, featuring elegant interiors and a tranquil garden</li>
        <li><strong>Aethang (映月堂):</strong> A pavilion reflected beautifully in the pond during moonlit nights</li>
      </ul>

      <h2>{t.h2_5}</h2>
      <div class="season-grid">
        <div class="season-card"><h4>Spring (Apr–May)</h4><p>Cherry blossoms, azaleas, and fresh greenery. Mild weather ideal for walking.</p></div>
        <div class="season-card"><h4>Summer (Jun–Aug)</h4><p>Lush green canopy, lotus flowers in Buyongji, cool shade under ancient trees.</p></div>
        <div class="season-card best"><h4>Autumn (Oct–Nov) ★</h4><p>The most spectacular season. Vibrant red, orange, and gold foliage reflected in ponds. Peak color mid-to-late November.</p></div>
        <div class="season-card"><h4>Winter (Dec–Feb)</h4><p>Snow-covered gardens offer serene beauty. Fewer visitors. Some areas may be restricted.</p></div>
      </div>

      <h2>{t.h2_6}</h2>
      <div class="info-box tip-box">
        <ul>
          <li>Wear comfortable walking shoes — the tour involves 2+ km of walking on uneven paths</li>
          <li>Follow the guide closely; leaving the group is not permitted</li>
          <li>Photography is allowed but no tripods or selfie sticks</li>
          <li>Bring water — there are no refreshment vendors inside the garden</li>
          <li>The 15:30 tour often has the best afternoon light for photography</li>
          <li>If you miss online booking, try calling the heritage hotline — some same-day tickets are occasionally available</li>
        </ul>
      </div>

      <div class="cta-box"><a href={`/palace/2?lang=${lang}`}>{t.cta}</a></div>

      <FAQSection items={faqByLang} lang={lang} />
    </article>
  </div>
</GuideLayout>

<style>
  .guide-content{padding:80px 0 60px;max-width:800px;margin:0 auto}
  .guide-content h1{font-family:'Noto Serif KR',serif;font-size:clamp(1.8rem,4vw,2.6rem);font-weight:700;margin-bottom:12px;line-height:1.3}
  .guide-meta{font-size:0.85rem;color:var(--color-text-muted,#9A8B7F);margin-bottom:24px}
  .guide-hero-img{width:100%;max-height:400px;object-fit:cover;border-radius:16px;margin-bottom:32px}
  .guide-intro{font-size:1.1rem;line-height:1.8;margin-bottom:32px;color:var(--color-text-light,#6B5B4F)}
  .guide-content h2{font-family:'Noto Serif KR',serif;font-size:1.4rem;font-weight:700;margin-top:48px;margin-bottom:16px;padding-bottom:10px;border-bottom:2px solid var(--color-accent,#D4A574)}
  .guide-content p{font-size:1rem;line-height:1.9;margin-bottom:16px}
  .guide-content ul{margin:12px 0 20px;padding-left:24px}
  .guide-content li{margin-bottom:8px;line-height:1.7;font-size:0.95rem}
  .info-box{background:var(--color-card,#fff);border:1px solid var(--color-border,#E8DDD4);border-radius:12px;padding:20px;margin:16px 0 24px}
  html.dark .info-box{background:var(--color-card,#1C1916);border-color:var(--color-border,#2D2720)}
  .tip-box{border-left:4px solid var(--color-primary,#C8956C)}
  .info-box ul{margin-top:8px;padding-left:20px}.info-box li{margin-bottom:6px;line-height:1.6;font-size:0.95rem}
  .spot-list{list-style:none;padding:0;margin:16px 0}.spot-list li{padding:10px 0;border-bottom:1px solid var(--color-border,#E8DDD4)}
  .season-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:20px 0 24px}
  .season-card{background:var(--color-card,#fff);border:1px solid var(--color-border,#E8DDD4);border-radius:12px;padding:16px}
  html.dark .season-card{background:var(--color-card,#1C1916);border-color:var(--color-border,#2D2720)}
  .season-card.best{border-color:var(--color-primary,#C8956C);background:rgba(200,149,108,0.05)}
  .season-card h4{font-size:0.95rem;font-weight:700;margin-bottom:6px;color:var(--color-text,#1A1210)}
  .season-card p{font-size:0.85rem;color:var(--color-text-light,#6B5B4F);line-height:1.6;margin:0}
  .cta-box{text-align:center;margin:32px 0}
  .cta-box a{display:inline-block;padding:14px 32px;background:var(--color-primary,#C8956C);color:#fff;border-radius:12px;font-weight:600;font-size:1rem;text-decoration:none;transition:background 0.3s,transform 0.2s}
  .cta-box a:hover{background:var(--color-primary-dark,#8B5E3C);transform:translateY(-2px)}
  @media(max-width:640px){.season-grid{grid-template-columns:1fr}}
</style>
