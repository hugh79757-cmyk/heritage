---
import Layout from '../layouts/Layout.astro';
import MapExplore from '../components/MapExplore.astro';
import DancheongCard from '../components/DancheongCard.astro';
import DancheongPatterns from '../components/DancheongPatterns.astro';
import '../styles/global.css';
import { PALACES, getLang, getPalaceName, getPalaceDesc } from '../lib/api';

const lang = getLang(Astro.url);
const htmlLang = lang === 'kr' ? 'ko' : lang;

const titles: Record<string, string> = {
  kr: '한국 궁궐·종묘 가이드 — K-Heritage Guide',
  en: 'Korean Palace & Shrine Guide — K-Heritage Guide',
  ja: '韓国宮殿・宗廟ガイド — K-Heritage Guide',
  zh: '韩国宫殿·宗庙指南 — K-Heritage Guide',
};
const descs: Record<string, string> = {
  kr: '경복궁, 창덕궁, 창경궁, 덕수궁, 종묘 — 4개 언어 해설과 사진으로 만나는 한국의 궁궐',
  en: 'Explore Gyeongbokgung, Changdeokgung, Changgyeonggung, Deoksugung & Jongmyo with multilingual guides',
  ja: '景福宮、昌德宮、昌慶宮、徳寿宮、宗廟 — 多言語ガイドで韓国の宮殿を探訪',
  zh: '景福宫、昌德宫、昌庆宫、德寿宫、宗庙 — 多语言导览韩国宫殿',
};

const hero = {
  kr: {
    badge: '한국 문화유산 가이드',
    hanja: '景福宮',
    title: '단청이 깨어난다',
    subtitle: '600년 궁궐의 화려함이 네온 빛으로 되살아납니다.\n경복궁부터 종묘까지 — 4개 언어로 탐험하세요.',
    cta1: '내 주변 탐색',
    cta2: '궁궐 둘러보기',
  },
  en: {
    badge: 'Korean Heritage Guide',
    hanja: 'Gyeongbokgung',
    title: 'The Palace Awakens',
    subtitle: '600 years of royal splendor, reborn in neon light.\nFrom Gyeongbokgung to Jongmyo — explore in 4 languages.',
    cta1: 'Explore Nearby',
    cta2: 'Browse Palaces',
  },
  ja: {
    badge: '韓国文化遺産ガイド',
    hanja: '景福宮',
    title: '宮殿が目覚める',
    subtitle: '600年の王宮の輝きがネオンの光で蘇る。\n景福宮から宗廟まで — 4言語で探訪しましょう。',
    cta1: '周辺を探す',
    cta2: '宮殿を見る',
  },
  zh: {
    badge: '韩国文化遗产指南',
    hanja: '景福宫',
    title: '宫殿苏醒',
    subtitle: '600年皇家辉煌在霓虹灯中重生。\n从景福宫到宗庙 — 用4种语言探索。',
    cta1: '探索附近',
    cta2: '浏览宫殿',
  },
};
const h = hero[lang];

const sec: Record<string, { h2: string; p: string }> = {
  kr: { h2: '5대 궁궐·종묘', p: '각 궁궐을 선택하면 건축물별 상세 해설을 볼 수 있습니다' },
  en: { h2: 'Five Grand Palaces & Jongmyo', p: 'Select a palace to explore detailed guides for each building' },
  ja: { h2: '五大宮殿・宗廟', p: '宮殿を選ぶと建築物ごとの詳細解説をご覧いただけます' },
  zh: { h2: '五大宫殿与宗庙', p: '选择宫殿，查看每座建筑的详细讲解' },
};
const s = sec[lang];

const kdhTitle: Record<string, string> = {
  kr: '케이팝 데몬 헌터스\n영감의 장소들',
  en: 'Seoul Inspirations of\nKPop Demon Hunters',
  ja: 'KPop Demon Hunters\nインスピレーションの場所',
  zh: 'KPop Demon Hunters\n灵感来源地',
};
const kdhSub: Record<string, string> = {
  kr: '애니메이션 영화 속 세계를 만든 서울의 실제 공간 —경복궁부터 N서울타워까지',
  en: 'The real Seoul places that shaped an animated world — from Gyeongbokgung to N Seoul Tower',
  ja: 'アニメーション映画の世界を形作ったソウルの実在空間 — 景福宮からNソウルタワーまで',
  zh: '塑造动画电影世界的首尔实存空间 — 从景福宫到N首尔塔',
};
const kdhBtn: Record<string, string> = {
  kr: '영감의 장소 보기',
  en: 'Explore Inspirations',
  ja: 'インスピレーションを見る',
  zh: '查看灵感地点',
};

const palaceColors = [
  'var(--palace-gyeongbok)',
  'var(--palace-changdeok)',
  'var(--palace-changgyeong)',
  'var(--palace-deoksu)',
  'var(--palace-jongmyo)',
];

const palaceHanja = ['景福宮', '昌德宮', '昌慶宮', '徳寿宮', '宗廟'];
---
<Layout title={titles[lang]} description={descs[lang]} lang={htmlLang}>
  <style>@import '../styles/global.css';</style>
  <DancheongPatterns />

  <!-- ═══ HERO — 2026 시네마틱 ═══ -->
  <section class="hero-full" id="hero">
    <div class="hero-bg">
      <img
        src="/images/generated/gyeongbok-hero-md.webp"
        srcset="/images/generated/gyeongbok-hero-sm.webp 375w, /images/generated/gyeongbok-hero-md.webp 768w, /images/generated/gyeongbok-hero-lg.webp 1200w"
        sizes="100vw"
        alt="Gyeongbokgung Geunjeongjeon"
        fetchpriority="high"
        width="768"
        height="1344"
        style="aspect-ratio: 768/1344; object-fit: cover;"
        decoding="async"
      />
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <span class="hero-badge">{h.badge}</span>
      <div class="hero-hanja">{h.hanja}</div>
      <h1 class="hero-title">{h.title}</h1>
      <p class="hero-subtitle" set:html={h.subtitle.replace(/\n/g, '<br/>')} />
      <div class="hero-cta">
        <a href="#map-section" class="btn btn-primary">{h.cta1} &darr;</a>
        <a href="#palaces" class="btn btn-outline">{h.cta2}</a>
      </div>
    </div>
    <div class="hero-scroll">
      SCROLL
      <div class="hero-scroll-line"></div>
    </div>
  </section>

  <!-- 민화 호작도 -->
  <figure class="minhwa-banner">
    <img
      src="/minhwa-tiger-magpie.jpeg"
      alt="조선 민화 호작도 — 호랑이와 까치"
      width="1200"
      height="600"
      loading="lazy"
    />
    <figcaption class="minhwa-caption"><span>600년 왕조의 수호자</span></figcaption>
  </figure>

  <!-- ═══ MAP ═══ -->
  <div class="container" id="map-section">
    <MapExplore lang={lang} />
  </div>

  <hr class="dancheong-divider" />

  <!-- ═══ 5대 궁궐 카드 ═══ -->
  <section id="palaces">
    <div class="container">
      <div class="section-header">
        <h2>{s.h2}</h2>
        <p>{s.p}</p>
      </div>
      <div class="card-grid">
        <DancheongCard
          name={getPalaceName(PALACES[0], lang)}
          nameH={palaceHanja[0]}
          desc={getPalaceDesc(PALACES[0], lang)}
          image={PALACES[0].image}
          href={`/palace/${PALACES[0].id}?lang=${lang}`}
          color={palaceColors[0]}
          lang={lang}
        />
        <DancheongCard
          name={getPalaceName(PALACES[1], lang)}
          nameH={palaceHanja[1]}
          desc={getPalaceDesc(PALACES[1], lang)}
          image={PALACES[1].image}
          href={`/palace/${PALACES[1].id}?lang=${lang}`}
          color={palaceColors[1]}
          lang={lang}
        />
        <DancheongCard
          name={getPalaceName(PALACES[2], lang)}
          nameH={palaceHanja[2]}
          desc={getPalaceDesc(PALACES[2], lang)}
          image={PALACES[2].image}
          href={`/palace/${PALACES[2].id}?lang=${lang}`}
          color={palaceColors[2]}
          lang={lang}
        />
        <DancheongCard
          name={getPalaceName(PALACES[3], lang)}
          nameH={palaceHanja[3]}
          desc={getPalaceDesc(PALACES[3], lang)}
          image={PALACES[3].image}
          href={`/palace/${PALACES[3].id}?lang=${lang}`}
          color={palaceColors[3]}
          lang={lang}
        />
        <DancheongCard
          name={getPalaceName(PALACES[4], lang)}
          nameH={palaceHanja[4]}
          desc={getPalaceDesc(PALACES[4], lang)}
          image={PALACES[4].image}
          href={`/palace/${PALACES[4].id}?lang=${lang}`}
          color={palaceColors[4]}
          lang={lang}
        />
      </div>
    </div>
  </section>

  <hr class="dancheong-divider" />

  <!-- ═══ 케데헌 트래픽 훅 ═══ -->
  <section class="kdh-hook">
    <div class="container">
      <div class="kdh-hook-inner">
        <span class="kdh-hook-badge">KPop Demon Hunters</span>
        <h2 class="kdh-hook-title" set:html={kdhTitle[lang]?.replace(/\n/g, '<br/>') || kdhTitle.en.replace(/\n/g, '<br/>')} />
        <p class="kdh-hook-sub">{kdhSub[lang] || kdhSub.en}</p>
        <p class="kdh-hook-note">
          {lang === 'kr' ? '※ KPop Demon Hunters는 애니메이션 영화입니다. 아래 장소는 실제 촬영지가 아니라 영화의 시각 세계관에 영감을 준 공간입니다.' :
           lang === 'ja' ? '※ KPop Demon Huntersはアニメーション映画です。以下の場所は実撮影地ではなく、映画の視覚世界観にインスピレーションを与えた空間です。' :
           lang === 'zh' ? '※ 《KPop Demon Hunters》是动画电影。以下地点并非实拍地，而是为电影视觉世界观提供灵感的空间。' :
           '※ KPop Demon Hunters is an animated film. The locations below are not filming sites — they are real places that inspired the film\'s visual world.'}
        </p>
        <a href={`/kpop-demon-hunters?lang=${lang}`} class="btn btn-primary">{kdhBtn[lang] || kdhBtn.en} &rarr;</a>
      </div>
    </div>
  </section>

  <!-- AdSense -->
  <div class="container" style="margin:2rem auto;max-width:728px;text-align:center;">
    <ins class="adsbygoogle"
         style="display:block;text-align:center"
         data-ad-layout="in-article"
         data-ad-format="fluid"
         data-ad-client="ca-pub-5938862195544185"
         data-ad-slot="4797390169"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "K-Heritage Guide",
    "url": "https://heritage.aikorea24.kr",
    "description": descs['en'],
    "inLanguage": ["ko","en","ja","zh"],
  })} />
</Layout>

<style>
  .hero-hanja {
    font-family: 'Noto Serif KR', serif;
    font-size: clamp(1rem, 3vw, 1.6rem);
    letter-spacing: 0.15em;
    margin-bottom: 8px;
    opacity: 0.85;
  }

  /* 민화 배너 */
  .minhwa-banner {
    position: relative;
    width: 100%;
    overflow: hidden;
    margin: 0;
  }
  .minhwa-banner img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    display: block;
    opacity: 0.8;
  }
  .minhwa-caption {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    font-size: clamp(1rem, 3vw, 1.4rem);
    letter-spacing: 0.2em;
    color: #fff;
    text-shadow: 0 1px 8px rgba(0,0,0,0.6);
  }
</style>
