---
export const prerender = true;

import GuideLayout from '../../components/GuideLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import QuickAnswerBox from '../../components/QuickAnswerBox.astro';
import '../../styles/global.css';
import { KDH_SCENES, getSceneByLocation, hasSceneImage } from '../../data/kdh-scenes';
import { getLang } from '../../lib/api';

export function getStaticPaths() {
  return KDH_SCENES.map(scene => ({
    params: { id: scene.id },
    props: { scene },
  }));
}

const { scene } = Astro.props;
const lang = getLang(Astro.url);
const htmlLang = lang === 'kr' ? 'ko' : lang;

function getTypeLabel(scene: typeof KDH_SCENES[0], lang: string): string {
  const labels: Record<string, Record<string, string>> = {
    kr: { scene: '장면 배경', inspiration: '건축적 영감', motif: '디자인 모티프' },
    en: { scene: 'Scene Location', inspiration: 'Architectural Inspiration', motif: 'Design Motif' },
    ja: { scene: 'シーンの舞台', inspiration: '建築的インスピレーション', motif: 'デザイン母題' },
    zh: { scene: '场景背景', inspiration: '建筑灵感', motif: '设计灵感' },
  };
  const langMap = lang === 'kr' || lang === 'ko' ? 'kr' : lang === 'ja' ? 'ja' : lang === 'zh' ? 'zh' : 'en';
  const type = scene.id === 'gyeongbokgung' ? 'inspiration' : scene.id === 'lotte-world-tower' ? 'motif' : 'scene';
  return (labels[langMap] && labels[langMap][type]) || (labels.en[type]);
}

const pageTitle = `${scene.sceneTitle[lang] || scene.sceneTitle.en} | KPop Demon Hunters | K-Heritage`;
const pageDescMap: Record<string, string> = {
  kr: `${scene.sceneDescription[lang] || scene.sceneDescription.en} — 방문 정보, 가는 법, 사진 포인트까지.`,
  en: `${scene.sceneDescription[lang] || scene.sceneDescription.en} — Visit info, directions, and photo spots.`,
  ja: `${scene.sceneDescription[lang] || scene.sceneDescription.en} — 訪問情報、アクセス、フォトスポット.`,
  zh: `${scene.sceneDescription[lang] || scene.sceneDescription.en} — 参观信息、交通方式、拍照景点.`,
};
const pageDesc = pageDescMap[lang] || pageDescMap.en;

const prevScene = KDH_SCENES.find(s => s.order === scene.order - 1);
const nextScene = KDH_SCENES.find(s => s.order === scene.order + 1);

const navLabels: Record<string, { prev: string; next: string; back: string; details: string }> = {
  kr: { prev: '이전 장소', next: '다음 장소', back: '전체 장소', details: '궁궐 상세 보기' },
  en: { prev: 'Previous Place', next: 'Next Place', back: 'All Places', details: 'View Palace Details' },
  ja: { prev: '前の場所', next: '次の場所', back: '全場所', details: '宮殿詳細を見る' },
  zh: { prev: '上一个地点', next: '下一个地点', back: '全部地点', details: '查看宫殿详情' },
};
const nav = navLabels[lang] || navLabels.en;

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'KPop Demon Hunters', url: `/kpop-demon-hunters?lang=${lang}` },
  { name: scene.sceneTitle[lang] || scene.sceneTitle.en },
];
---

<GuideLayout title={pageTitle} description={pageDesc} lang={htmlLang}>
  <style>@import '../../styles/global.css';</style>

  {/* ── 영웅 섹션 (인지 단계: 0~3초) ── */}
  <section class={`kdh-scene-hero${hasSceneImage(scene) ? '' : ' kdh-scene-hero-noimg'}`}>
    <div class="kdh-scene-bg">
      {hasSceneImage(scene) && (
        <img
          src={`/images/generated/${scene.imageId}-md.webp`}
          srcset={`/images/generated/${scene.imageId}-sm.webp 375w, /images/generated/${scene.imageId}-md.webp 768w, /images/generated/${scene.imageId}-lg.webp 1200w`}
          sizes="100vw"
          alt={scene.sceneTitle[lang] || scene.sceneTitle.en}
          fetchpriority="high"
          width="768"
          height="1344"
          style="aspect-ratio: 768/1344; object-fit: cover;"
        />
      )}
      <div class="kdh-scene-overlay"></div>
    </div>
    <div class="kdh-scene-hero-content">
      <span class="kdh-scene-badge">KPop Demon Hunters</span>
      <span class="kdh-scene-type-badge">{getTypeLabel(scene, lang)}</span>
      <h1 class="kdh-scene-title">{scene.sceneTitle[lang] || scene.sceneTitle.en}</h1>
    </div>
  </section>

  <div class="kdh-scene-body container">

    {/* ── 즉답 정보 (3~30초 단계) ── */}
    <QuickAnswerBox
      address={scene.address}
      directions={scene.directions}
      hours={scene.hours}
      duration={scene.duration}
      mapLinks={scene.mapLinks}
      lang={lang}
    />

    <hr class="section-divider" />

    {/* ── 영화 맥락 (몰입 단계: 30초~3분) ── */}
    <section class="kdh-scene-context-section">
      <div class="section-label">{lang === 'kr' ? '영화 속 장면' : lang === 'ja' ? '映画のシーン' : lang === 'zh' ? '电影场景' : 'Film Scene'}</div>
      <h2>{scene.sceneTitle[lang] || scene.sceneTitle.en}</h2>
      <p class="kdh-hook-quote">"{scene.sceneDescription[lang] || scene.sceneDescription.en}"</p>
      <div class="kdh-context-body">
        <p>{scene.filmContext[lang] || scene.filmContext.en}</p>
      </div>
    </section>

    <hr class="section-divider" />

    {/* ── 행동 단계: 네비게이션 ── */}
    <nav class="kdh-scene-nav">
      {scene.palaceLink && (
        <a href={`${scene.palaceLink}?lang=${lang}`} class="btn btn-primary">
          {nav.details}
        </a>
      )}
      <div class="kdh-nav-links">
        <a href={`/kpop-demon-hunters?lang=${lang}`} class="btn btn-outline">
          &larr; {nav.back}
        </a>
      </div>
    </nav>

    {prevScene && (
      <nav class="kdh-scene-nav-block">
        <span class="kdh-nav-label">{nav.prev}</span>
        <a href={`/kpop-demon-hunters/${prevScene.id}?lang=${lang}`} class="btn btn-outline">
          {prevScene.sceneTitle[lang] || prevScene.sceneTitle.en}
        </a>
      </nav>
    )}
    {nextScene && (
      <nav class="kdh-scene-nav-block">
        <span class="kdh-nav-label">{nav.next}</span>
        <a href={`/kpop-demon-hunters/${nextScene.id}?lang=${lang}`} class="btn btn-outline">
          {nextScene.sceneTitle[lang] || nextScene.sceneTitle.en}
        </a>
      </nav>
    )}

  </div>
</GuideLayout>

<style>
  .kdh-scene-hero {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #12101A;
    padding: 60px 24px;
  }
  .kdh-scene-hero-noimg {
    background: linear-gradient(160deg, #1C1925 0%, #12101A 55%, #0A0810 100%);
  }
  .kdh-scene-bg {
    position: absolute;
    inset: 0;
  }
  .kdh-scene-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
  }
  .kdh-scene-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8,5,16,0.1) 0%, rgba(8,5,16,0.7) 100%);
  }
  .kdh-scene-hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 640px;
  }
  .kdh-scene-badge {
    display: inline-block;
    padding: 4px 14px;
    background: var(--color-primary, #A8D0E6);
    color: var(--color-text, #2C3E50);
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 8px;
    letter-spacing: 0.05em;
  }
  .kdh-scene-type-badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 500;
    color: rgba(245,240,232,0.45);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .kdh-scene-title {
    font-family: 'Noto Serif KR', serif;
    font-weight: 900;
    font-size: clamp(1.8rem, 5vw, 3rem);
    line-height: 1.2;
    color: #fff;
    margin-bottom: 8px;
  }

  .kdh-scene-body {
    padding-top: 32px;
    padding-bottom: 64px;
  }

  .kdh-scene-context-section {
    padding: 32px 0;
  }
  .section-label {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary, #A8D0E6);
    margin-bottom: 8px;
  }
  .kdh-scene-context-section h2 {
    font-family: 'Noto Serif KR', serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text, #2C3E50);
    margin-bottom: 20px;
  }
  .kdh-hook-quote {
    font-family: 'Noto Serif KR', serif;
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-text-light, #7F8C8D);
    padding: 20px 24px;
    border-left: 3px solid var(--color-primary, #A8D0E6);
    background: var(--color-card, #F8F4E3);
    border-radius: 0 var(--radius, 12px) var(--radius, 12px) 0;
    margin-bottom: 24px;
  }
  .kdh-context-body p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text, #2C3E50);
  }

  .section-divider {
    border: none;
    height: 1px;
    background: var(--color-border-light, rgba(232,216,195,0.3));
    margin: 32px 0;
  }

  .kdh-scene-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 16px;
  }
  .kdh-nav-links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .kdh-scene-nav-block {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid var(--color-border-light, rgba(232,216,195,0.2));
  }
  .kdh-nav-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted, #95a5a6);
  }

  @media (max-width: 640px) {
    .kdh-scene-hero {
      min-height: 40vh;
      padding: 50px 20px;
    }
    .kdh-scene-nav {
      flex-direction: column;
      align-items: stretch;
    }
    .kdh-nav-links {
      justify-content: center;
    }
    .kdh-scene-nav-block {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }

  .dark .kdh-scene-context-section h2 {
    color: var(--color-text);
  }
  .dark .kdh-context-body p {
    color: rgba(245,240,232,0.8);
  }
  .dark .kdh-hook-quote {
    color: rgba(245,240,232,0.75);
    background: rgba(168, 208, 230, 0.08);
  }
</style>
