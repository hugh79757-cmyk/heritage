---
import GuideLayout from '../../components/GuideLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import FAQSection from '../../components/FAQSection.astro';
import '../../styles/global.css';
import { fetchPalaceList, getLang } from '../../lib/api';

const lang = getLang(Astro.url);
const htmlLang = lang === 'kr' ? 'ko' : lang;
const buildings = await fetchPalaceList(5);

const title = {
  kr: '종묘 완전 가이드 2026 | K-Heritage',
  en: 'Jongmyo Shrine Complete Guide 2026 | K-Heritage',
  ja: '宗廟 完全ガイド 2026 | K-Heritage',
  zh: '宗庙完全指南 2026 | K-Heritage',
}[lang] ?? '';

const description = {
  kr: '종묘 입장료, 개방시간, UNESCO 세계유산 의의, 종묘제례, 관람 팁 완전 정리.',
  en: 'Complete guide to Jongmyo Shrine: ticket prices, opening hours, UNESCO World Heritage significance, royal ancestral rites, and visitor tips for 2026.',
  ja: '宗廟の完全ガイド：チケット料金、営業時間、UNESCO世界遺産の意義、宗廟祭礼、観光ヒント 2026年版。',
  zh: '宗庙完全指南：门票价格、开放时间、UNESCO世界遗产意义、宗庙祭礼、游客贴士 2026版。',
}[lang] ?? '';

const faqByLang: Record<string, { question: string; answer: string }[]> = {
  kr: [
    { question: '종묘는 무엇인가요?', answer: '종묘(宗廟)는 조선 왕조의 왕실 사당으로, 왕과 왕비를 제사지낸 곳입니다. 1995년 UNESCO 세계유산으로 지정.' },
    { question: '종묘 티켓 가격은?', answer: '성인 ₩1,000, 청소년(7~18세) ₩500. 7세 이하·65세 이상 무료. 서울 유산 중 최저가.' },
    { question: '개방시간은?', answer: '3~10월 09:00~18:00 (마지막 입장 17:30), 11~2월 09:00~17:00 (마지막 입장 16:30). 화요일 휴관. 정전은 가이드 투어 필수.' },
    { question: '종묘제례란?', answer: '종묘제례는 매년 5월 첫째 일요일에 거행되는 왕실 제례. 28명의 음악가와 64명의 무용수가 전통 의상을 입고 공연. 2001년 유네스코 무형문화유산 지정.' },
  ],
  en: [
    { question: 'What is Jongmyo Shrine?', answer: 'Jongmyo (종묘) is the royal ancestral shrine of the Joseon dynasty, where ceremonies honoring deceased kings and queens were performed. It was designated a UNESCO World Heritage Site in 1995.' },
    { question: 'How much is the Jongmyo ticket?', answer: 'Adults: ₩1,000. Youth (7–18): ₩500. Free for children under 7 and seniors 65+. The cheapest of all Seoul heritage sites.' },
    { question: 'What are Jongmyo opening hours?', answer: '09:00–18:00 (Mar–Oct), 09:00–17:00 (Nov–Feb). Closed Tuesdays. The main hall (Jeongjeon) requires a guided tour to enter.' },
    { question: 'What is Jongmyo Jerye?', answer: 'Jongmyo Jerye (종묘제례) is the Royal Ancestral Rite, performed annually on the first Sunday of May. It is an Intangible Cultural Heritage, featuring traditional music (Jeryeak) and dance (Jerye Mu).' },
  ],
  ja: [
    { question: '宗廟とは？', answer: '宗廟（종묘）は朝鮮王朝の王室祠堂で、王と王妃を祀りました。1995年にUNESCO世界遺産に指定。' },
    { question: 'チケット料金は？', answer: '大人₩1,000、青少年（7〜18歳）₩500。7歳未満・65歳以上無料。ソウルの遺産施設で最も安い。' },
    { question: '営業時間は？', answer: '3〜10月 09:00〜18:00（最終入場17:30）、11〜2月 09:00〜17:00（最終入場16:30）。火曜日休館。正殿はガイドツアー必須。' },
    { question: '宗廟祭礼とは？', answer: '宗廟祭礼は毎年5月第1日曜日に行われる王室の祭礼。28名の音楽家と64名の舞踏家が伝統衣装で公演。2001年ユネスコ無形文化遺産に指定。' },
  ],
  zh: [
    { question: '宗庙是什么？', answer: '宗庙（종묘）是朝鲜王朝的王室祠堂，祭祀国王和王后。1995年被列为UNESCO世界遗产。' },
    { question: '门票价格？', answer: '成人₩1,000，青少年（7-18岁）₩500。7岁以下及65岁以上免费。首尔遗产设施中最便宜。' },
    { question: '开放时间？', answer: '3-10月 09:00-18:00（最后入场17:30），11-2月 09:00-17:00（最后入场16:30）。周二闭馆。正殿需参加导览团。' },
    { question: '宗庙祭礼是什么？', answer: '宗庙祭礼是每年5月第一个周日举行的王室祭祀仪式。28名乐师和64名舞者身着传统服饰表演。2001年被列为UNESCO非物质文化遗产。' },
  ],
};
const faqItems = faqByLang[lang] || faqByLang.en;

const h: Record<string, any> = {
  en: {
    h1: 'Jongmyo Shrine Complete Guide 2026',
    intro: 'Jongmyo Shrine (종묘) is the UNESCO World Heritage royal ancestral shrine of the Joseon dynasty, where ceremonies honoring deceased kings and queens were performed for over 500 years. The shrine houses spirit tablets of 49 kings and queens, making it one of the longest continuously used shrines in the world. It represents the pinnacle of Confucian architectural design in Korea.',
    h2_1: 'Ticket Prices & Admission',
    h2_2: 'Opening Hours & Guided Tours',
    h2_3: 'How to Get There',
    h2_4: 'UNESCO World Heritage Significance',
    h2_5: 'Jongmyo Jerye — Royal Ancestral Rite',
    h2_6: 'Visitor Tips',
    buildings_text: 'The main structure is Jeongjeon (정전), the Primary Hall, which stretches 101 meters — making it the longest wooden building in Asia. It houses 49 spirit tablets in individual chambers. Yeongnyeongjeon (영녕전), the Secondary Hall, houses 35 additional tablets. The grounds also include the Hongnyemun Gate and Ancestral Rite Museum.',
    cta: 'Explore all buildings at Jongmyo →',
  },
  kr: {
    h1: '종묘 완전 가이드 2026',
    intro: '종묘(宗廟)는 조선 왕조의 왕실 사당으로, 500년 넘게 왕과 왕비를 제사지낸 UNESCO 세계유산입니다. 49위의 왕과 왕비의 신주가 모셔져 있으며, 세계에서 가장 오래 사용된 사당 중 하나입니다.',
    h2_1: '관람권 및 입장료',
    h2_2: '개방시간 및 가이드 투어',
    h2_3: '교통 안내',
    h2_4: 'UNESCO 세계유산 의의',
    h2_5: '종묘제례',
    h2_6: '관람 팁',
    buildings_text: '본전(正殿)인 정전은 길이 101m로 아시아에서 가장 긴 목조건물입니다. 49위의 왕과 왕비 신주가 모셔져 있으며, 영녕전(永寧殿)에는 추가 35위의 신주가 있습니다.',
    cta: '종묘 건물 전체 보기 →',
  },
  ja: {
    h1: '宗廟 完全ガイド 2026',
    intro: '宗廟（종묘）は朝鮮王朝の王室祠堂で、500年以上にわたり王と王妃を祀り続けたUNESCO世界遺産です。49柱の王と王妃の位牌が安置され、世界で最も長く使用され続けている祠堂の一つです。',
    h2_1: 'チケット料金',
    h2_2: '営業時間とガイドツアー',
    h2_3: 'アクセス方法',
    h2_4: 'UNESCO世界遺産の意義',
    h2_5: '宗廟祭礼',
    h2_6: '観光ヒント',
    buildings_text: '本殿である正殿は長さ101mでアジア最長の木造建築。49柱の王と王妃の位牌が安置され、永寧殿には追加35柱の位牌があります。',
    cta: '宗廟の全建築物を見る →',
  },
  zh: {
    h1: '宗庙完全指南 2026',
    intro: '宗庙（종묘）是朝鲜王朝的王室祠堂，500多年来一直祭祀国王和王后，是UNESCO世界遗产。安放了49位国王和王后的神主，是世界上使用时间最长的祠堂之一。',
    h2_1: '门票价格',
    h2_2: '开放时间与导览',
    h2_3: '交通指南',
    h2_4: 'UNESCO世界遗产意义',
    h2_5: '宗庙祭礼',
    h2_6: '游客贴士',
    buildings_text: '正殿（정전）长101米，是亚洲最长的木结构建筑。安放了49位国王和王后的神主，永宁殿安放了另外35位。',
    cta: '查看宗庙全部建筑 →',
  },
};

const t = h[lang] || h.en;

const body = {
  kr: {
    price: '성인: ₩1,000 · 청소년(7~18세): ₩500 · 7세 이하·65세 이상 무료',
    hours: '<strong>3~10월:</strong> 09:00~18:00 (마지막 입장 17:30)<br/><strong>11~2월:</strong> 09:00~17:00 (마지막 입장 16:30)<br/><strong>휴관:</strong> 매주 화요일<br/><strong>참고:</strong> 정전(본전) 입장은 무료 가이드 투어 필수, 일정 시간 운행',
    transport: '<strong>지하철:</strong> 1·3·5호선 종로3가역(11번 출구) — 도보 5분<br/><strong>버스:</strong> 101, 162, 171, 272, 606번 종로3가 하차',
    unesco: '종묘는 유교 건축과 제례의 걸작으로 1995년 UNESCO 세계유산에 지정되었습니다. 500년 넘게 사용된 세계에서 가장 오래된 사당 중 하나입니다.\n\n건축은 엄격한 유교 원칙을 따르며 — 소박한 목조건물이 장엄함과 존경을 강조합니다. 101m 길이의 정전은 아시아에서 가장 긴 목조건물로, 전통 공학의 놀라운 업적입니다.',
    jerye: '종묘제례(종묘제례)는 매년 5월 첫째 일요일에 거행됩니다. 이 정교한 의식에는 28명의 음악가와 64명의 무용수가 전통 의상을 입고 고궁 음악과 춤을 선보입니다. 2001년 종묘제례악(고궁 음악)은 유네스코 인류 무형문화유산으로 지정되었습니다.',
    tips: ['정전 가이드 투어는 무료이며 20~30분 간격으로 운행', '내부 제례박물관 무료 관람', '창경궁(인접)과 연계하면 하루 코스 완성', '5월 제례 관람이 목적이라면 5월 방문 추천', '정전의 긴 복도형 내부는 독특한 촬영 포인트'],
  },
  en: {
    price: 'Adults: ₩1,000 · Youth (7–18): ₩500 · Children under 7 & Seniors 65+: Free',
    hours: '<strong>Mar–Oct:</strong> 09:00–18:00 (last entry 17:30)<br/><strong>Nov–Feb:</strong> 09:00–17:00 (last entry 16:30)<br/><strong>Closed:</strong> Every Tuesday<br/><strong>Note:</strong> Entry to Jeongjeon (main hall) requires a free guided tour, available at fixed intervals.',
    transport: '<strong>Subway:</strong> Line 1/3/5 Jongno 3-ga Station (Exit 11) — 5 min walk.<br/><strong>Bus:</strong> Routes 101, 162, 171, 272, 606 stop near Jongno 3-ga.',
    unesco: 'Jongmyo was designated a UNESCO World Heritage Site in 1995 for its outstanding universal value as a masterpiece of Confucian architecture and ritual practice. The shrine has been continuously used for over 500 years, making it one of the oldest and longest-operating shrines in East Asia.\n\nThe architectural design follows strict Confucian principles — the simple, unadorned wooden structures emphasize solemnity and respect. The 101-meter-long Jeongjeon is the longest wooden building in Asia, a remarkable feat of traditional engineering.',
    jerye: 'The annual Royal Ancestral Rite (종묘제례, Jongmyo Jerye) is performed on the first Sunday of May. This elaborate ceremony features 28 musicians and 64 dancers in traditional costumes, performing ancient court music and dances to honor the spirits of deceased monarchs. In 2001, the Jongmyo Jeryeak (court music) was designated a UNESCO Intangible Cultural Heritage of Humanity.',
    tips: ['The guided tour of Jeongjeon is free and runs every 20-30 minutes', 'The Ancestral Rite Museum inside the grounds is free to enter', 'Combine with Changgyeonggung (adjacent) for a full day', 'May is the best month to visit if you want to see the Jerye ceremony', 'The long, corridor-like interior of Jeongjeon is a unique photo opportunity'],
  },
  ja: {
    price: '大人: ₩1,000 · 青少年(7~18歳): ₩500 · 7歳未満・65歳以上無料',
    hours: '<strong>3~10月:</strong> 09:00~18:00（最終入場17:30）<br/><strong>11~2月:</strong> 09:00~17:00（最終入場16:30）<br/><strong>休館:</strong> 毎週火曜日<br/><strong>注意:</strong> 正殿入場は無料ガイドツアー必須、定時運行',
    transport: '<strong>地下鉄:</strong> 1·3·5号線鐘路3街駅（11番出口）— 徒歩5分<br/><strong>バス:</strong> 101, 162, 171, 272, 606便 鐘路3街下車',
    unesco: '宗廟は儒教建築と祭礼の傑作として1995年にUNESCO世界遺産に指定。500年以上使用され続けている東アジア最古の祠堂の一つ。\n\n建築は厳格な儒教原則に従い — 素朴な木造建築が厳粛さと敬意を強調。101mの正殿はアジア最長の木造建築で、伝統工学の偉業。',
    jerye: '宗廟祭礼は毎年5月第1日曜日に行われる。28名の音楽家と64名の舞踏家が伝統衣装で古代の宮廷音楽と踊りを披露。2001年に宗廟祭礼楽はユネスコ無形文化遺産に指定。',
    tips: ['正殿ガイドツアーは無料で20〜30分ごと運行', '境内の祭礼博物館は無料見学', '昌慶宮（隣接）と組み合わせて一日コース', '祭礼を見たいなら5月がベスト', '正殿の長い廊下のような内部は独特の撮影ポイント'],
  },
  zh: {
    price: '成人: ₩1,000 · 青少年(7~18岁): ₩500 · 7岁以下·65岁以上免费',
    hours: '<strong>3~10月:</strong> 09:00~18:00（最后入场17:30）<br/><strong>11~2月:</strong> 09:00~17:00（最后入场16:30）<br/><strong>闭馆:</strong> 每周二<br/><strong>注意:</strong> 正殿入场需免费导览团，定时运行',
    transport: '<strong>地铁:</strong> 1·3·5号线钟路3街站（11号出口）— 步行5分钟<br/><strong>公交:</strong> 101, 162, 171, 272, 606路 钟路3街下车',
    unesco: '宗庙作为儒学建筑和祭祀仪式的杰作，于1995年被列为UNESCO世界遗产。已使用超过500年，是东亚最古老的祠堂之一。\n\n建筑设计遵循严格的儒学原则——朴素的木结构强调庄严与敬意。101米长的正殿是亚洲最长的木结构建筑，是传统工程的杰出成就。',
    jerye: '宗庙祭礼每年5月第一个周日举行。这一精心策划的仪式由28名乐师和64名舞者身着传统服饰，演奏古代宫廷音乐和舞蹈以祭祀已故君王的灵魂。2001年宗庙祭礼乐被列为UNESCO非物质文化遗产。',
    tips: ['正殿导览免费，每20-30分钟一趟', '境内祭礼博物馆免费参观', '与昌庆宫（相邻）组合可构成一日游', '5月想看祭礼仪式最佳', '正殿长廊般的内部是独特的拍摄点'],
  },
}[lang] ?? { price: '', hours: '', transport: '', unesco: '', jerye: '', tips: [] };

function getBldName(b: typeof buildings[0]) {
  const map: Record<string, string> = { kr: b.nameKr, en: b.nameEn, ja: b.nameJa, zh: b.nameZh };
  return map[lang] || b.nameEn;
}
---
<GuideLayout title={title} description={description} lang={htmlLang}>
  <style>@import '../../styles/global.css';</style>
  <div class="container">
    <BreadcrumbNav items={[{ name: 'Home', url: '/' }, { name: 'Guide', url: '/guide' }, { name: 'Jongmyo' }]} lang={lang} />
    <article class="guide-content">
      <h1>{t.h1}</h1>
      <p class="guide-meta">Updated: June 2026 &middot; Korea Heritage Service official data</p>
      <img class="guide-hero-img" src="https://www.heritage.go.kr/gung/gogung5/images/img_jongmyo_story_bg_00_00.jpg" alt="Jongmyo Shrine" width="960" height="400" />
      <p class="guide-intro">{t.intro}</p>

      <h2>{t.h2_1}</h2>
      <div class="info-box"><p>{body.price}</p></div>

      <h2>{t.h2_2}</h2>
      <div class="info-box" set:html={body.hours} />

      <h2>{t.h2_3}</h2>
      <p set:html={body.transport} />

      <h2>{t.h2_4}</h2>
      {body.unesco.split('\n\n').map(p => <p>{p}</p>)}

      <h2>{t.h2_5}</h2>
      <p>{body.jerye}</p>

      <h2>{t.h2_6}</h2>
      <div class="info-box tip-box">
        <ul>
          {body.tips.map(tip => <li>{tip}</li>)}
        </ul>
      </div>

      <FAQSection items={faqByLang} lang={lang} />
    </article>
  </div>
</GuideLayout>

<style>
  .guide-content{padding:80px 0 60px;max-width:800px;margin:0 auto}
  .guide-content h1{font-family:'Noto Serif KR',serif;font-size:clamp(1.8rem,4vw,2.6rem);font-weight:700;margin-bottom:12px;line-height:1.3}
  .guide-meta{font-size:0.85rem;color:var(--color-text-muted,#9A8B7F);margin-bottom:24px}
  .guide-hero-img{width:100%;max-height:400px;object-fit:cover;border-radius:16px;margin-bottom:32px}
  .guide-intro{font-size:1.1rem;line-height:1.8;margin-bottom:32px;color:var(--color-text-light,#6B5B4F)}
  .guide-content h2{font-family:'Noto Serif KR',serif;font-size:1.4rem;font-weight:700;margin-top:48px;margin-bottom:16px;padding-bottom:10px;border-bottom:2px solid var(--color-accent,#D4A574)}
  .guide-content p{font-size:1rem;line-height:1.9;margin-bottom:16px}
  .info-box{background:var(--color-card,#fff);border:1px solid var(--color-border,#E8DDD4);border-radius:12px;padding:20px;margin:16px 0 24px}
  html.dark .info-box{background:var(--color-card,#1C1916);border-color:var(--color-border,#2D2720)}
  .tip-box{border-left:4px solid var(--color-primary,#C8956C)}
  .info-box ul{margin-top:8px;padding-left:20px}.info-box li{margin-bottom:6px;line-height:1.6;font-size:0.95rem}
  .building-highlights{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;margin:20px 0 24px}
  .building-highlight-card{display:flex;align-items:center;gap:12px;padding:12px;background:var(--color-card,#fff);border:1px solid var(--color-border,#E8DDD4);border-radius:10px;text-decoration:none;color:inherit;transition:border-color 0.2s}
  html.dark .building-highlight-card{background:var(--color-card,#1C1916);border-color:var(--color-border,#2D2720)}
  .building-highlight-card:hover{border-color:var(--color-primary,#C8956C)}
  .building-highlight-card img{width:80px;height:56px;object-fit:cover;border-radius:8px;flex-shrink:0}
  .building-highlight-card h4{font-size:0.9rem;font-weight:600;margin-bottom:4px;color:var(--color-text,#1A1210)}
  .building-highlight-card p{font-size:0.78rem;color:var(--color-text-muted,#9A8B7F);margin:0;line-height:1.4}
  .cta-box{text-align:center;margin:32px 0}
  .cta-box a{display:inline-block;padding:14px 32px;background:var(--color-primary,#C8956C);color:#fff;border-radius:12px;font-weight:600;font-size:1rem;text-decoration:none;transition:background 0.3s,transform 0.2s}
