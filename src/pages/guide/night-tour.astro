import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import FAQSection from '../../components/FAQSection.astro';
import '../../styles/global.css';
import { getLang } from '../../lib/api';

const lang = getLang(Astro.url);
const htmlLang = lang === 'kr' ? 'ko' : lang;

const titles: Record<string, string> = {
  kr: '서울 궁궐 야간개장 완전 가이드 2026 — K-Heritage',
  en: 'Seoul Palace Night Tour Guide 2026 | K-Heritage',
  ja: 'ソウル宮殿 夜間開場 完全ガイド 2026 — K-Heritage',
  zh: '首尔宫殿夜间开放完全指南 2026 — K-Heritage',
};
const descriptions: Record<string, string> = {
  kr: '서울 궁궐 야간개장(야간개장) 완전 안내: 경복궁·창덕궁·창경궁 야간개장 일정, 예약 팁, 2026년 정보',
  en: 'Complete guide to Seoul palace night tours (야간개장): Gyeongbokgung, Changdeokgung, Changgyeonggung night tour schedules, reservation tips, and what to expect in 2026.',
  ja: 'ソウル宮殿夜間開場の完全ガイド：景福宮、昌德宮、昌慶宮の夜間開場スケジュール、予約のコツ、2026年最新情報',
  zh: '首尔宫殿夜间开放完全指南：景福宫、昌德宫、昌庆宫夜间开放日程、预约技巧、2026年最新信息',
};

const faqByLang: Record<string, { question: string; answer: string }[]> = {
  kr: [
    { question: '야간개장 대상 궁궐은?', answer: '경복궁, 창덕궁, 창경궁이 특별 야간개장을 개최합니다. 덕수궁은 별도 야간개장 없이 매일 밤 9시까지 개방됩니다.' },
    { question: '야간개장 티켓은 어떻게 예약하나요?', answer: '국가유산청 홈페이지(heritage.go.kr)에서 예약합니다. 행사 2~3주 전에 티켓이 오픈되며 몇 시간 내에 매진됩니다. 알림 설정을 하고 오픈 즉시 예약하세요.' },
    { question: '야간개장 티켓 가격은?', answer: '야간개장 티켓은 일반적으로 일반 입장료와 동일하게 성인 ₩3,000, 청소년 ₩1,500입니다. 특별 행사에 따라 가격이 달라질 수 있습니다.' },
    { question: '야간개장은 언제 열리나요?', answer: '봄(4~5월)과 가을(9~11월)에 열립니다. 정확한 날짜는 2~3주 전에 공지됩니다. 각 궁궐은 계절당 보통 2~4회 야간개장을 개최합니다.' },
    { question: '야간개장 방문 시 무엇을 챙겨야 하나요?', answer: '저녁에는 쌀쌀하므로 가벼운 겉옷, 편안한 신발, 사진 촬영을 위한 완충된 휴대폰을 챙기세요. 플래시 촬영은 제한될 수 있으며, 삼각대는 보통 허용되지 않습니다.' },
    { question: '야간개장은 worth it 한가요?', answer: '물론입니다. 밤에 조명을 받은 궁궐은 낮과는 완전히 다른 마법 같은 분위기를 자아냅니다. 특히 창경궁 달빛기행은 lanterns 들고 정원을 걷는 체험으로 유명합니다.' },
  ],
  en: [
    { question: 'Which palaces offer night tours?', answer: 'Three palaces host special night tours: Gyeongbokgung, Changdeokgung, and Changgyeonggung. Deoksugung is regularly open until 9 PM and doesn\'t need a separate night tour event.' },
    { question: 'How do I reserve night tour tickets?', answer: 'Reserve through the Korea Heritage Service website (heritage.go.kr). Tickets are released 2-3 weeks before each event and sell out within hours. Set alerts and book immediately when released.' },
    { question: 'How much are night tour tickets?', answer: 'Night tour tickets are typically ₩3,000 for adults and ₩1,500 for youth, the same as regular admission. Some special events may have different pricing.' },
    { question: 'When do night tours happen?', answer: 'Night tours are held during spring (April–May) and autumn (September–November). Exact dates are announced 2-3 weeks in advance. Each palace typically hosts 2-4 events per season.' },
    { question: 'What should I bring to a night tour?', answer: 'Bring a light jacket (evenings are cool), comfortable shoes, and a fully charged phone for photos. Flash photography may be restricted. Tripods are usually not allowed.' },
    { question: 'Is the night tour worth it?', answer: 'Absolutely. The illuminated palaces at night create a magical atmosphere completely different from daytime visits. The Changgyeonggung Moonlight Tour is particularly famous for its lantern-lit paths through the garden.' },
  ],
  ja: [
    { question: '夜間営業対象の宮殿は？', answer: '景福宮、昌徳宮、昌慶宮が特別な夜間営業を開催します。徳寿宮は別途夜間営業なしで毎日夜9時まで開いています。' },
    { question: '夜間営業チケットはどう予約する？', answer: '韓國遺産廳のウェブサイト（heritage.go.kr）で予約。イベントの2〜3週間前にチケットが発売され、数時間で完売。アラートを設定して発売直後に予約を。' },
    { question: '夜間営業チケットの料金は？', answer: '夜間営業チケットは通常、大人₩3,000、青少年₩1,500で、通常入場料と同じです。特別イベントによっては価格が異なる場合も。' },
    { question: '夜間営業はいつ開催される？', answer: '春（4〜5月）と秋（9〜11月）に開催。正確な日付は2〜3週間前に発表。各宮殿はシーズンあたり通常2〜4回の夜間営業を開催。' },
    { question: '夜間営業には何を持っていくべき？', answer: '夕方は肌寒いので軽い上着、快適な靴、写真撮影用の充電されたスマホを。フラッシュ撮影は制限される場合あり、三脚は通常不可。' },
    { question: '夜間営業は行く価値ある？', answer: 'もちろんです。夜間照明された宮殿は昼間とは全く異なる魔法のような雰囲気。昌慶宮の月光ツアーは特に、ランタンを持って庭を歩く体験で有名。' },
  ],
  zh: [
    { question: '夜间开放対象宫殿有哪些？', answer: '景福宫、昌德宫、昌庆宫举办特别夜间开放。德寿宫无需特别夜间开放，毎天晚上9点前都会开放。' },
    { question: '夜间开放门票怎么预约？', answer: '在韩国遗产厅网站（heritage.go.kr）预约。活动前2-3周开售，几小时内售罄。设置提醒并在开售后立即预约。' },
    { question: '夜间开放门票价格？', answer: '夜间开放门票通常与普通门票价格相同：成人₩3,000，青少年₩1,500。特殊活动可能会有不同定价。' },
    { question: '夜间开放什么时候举办？', answer: '春季（4-5月）和秋季（9-11月）举办。确切日期提前2-3周公布。每个宫殿每季通常举办2-4次夜间开放。' },
    { question: '夜间开放需要带什么？', answer: '晚上天气转凉，建议带件轻薄外套、穿舒适的鞋子、手机保持充足电量以供拍照。闪光摄影可能受限，三脚架通常不允许。' },
    { question: '夜间开放值得去吗？', answer: '绝对值得。夜间灯光照射的宫殿营造出与白天完全不同的魔幻氛围。昌庆宫月光 tour 因手持灯笼穿行花园的体验而尤其著名。' },
  ],
};
const faqItems = faqByLang[lang] || faqByLang.en;

