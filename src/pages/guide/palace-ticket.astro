---
import GuideLayout from '../../components/GuideLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import FAQSection from '../../components/FAQSection.astro';
import '../../styles/global.css';
import { getLang } from '../../lib/api';

const lang = getLang(Astro.url);
const htmlLang = lang === 'kr' ? 'ko' : lang;

const title = {
  kr: '궁궐 통합관람권 완전 가이드 2026 | K-Heritage',
  en: 'Seoul Palace Integrated Ticket Guide 2026 | K-Heritage',
  ja: 'ソウル宮殿統合観覧券ガイド 2026 | K-Heritage',
  zh: '首尔宫殿综合门票指南 2026 | K-Heritage',
}[lang] ?? 'Seoul Palace Integrated Ticket Guide 2026 | K-Heritage';

const description = {
  kr: '궁궐 통합관람권 가격, 구매 방법, 포함 궁궐, 유효기간, 가성비 분석까지 2026년 완전 가이드.',
  en: 'Complete guide to Seoul palace integrated ticket (궁궐 통합관람권): price, where to buy, which palaces are included, validity period, and money-saving tips for 2026.',
  ja: 'ソウル宮殿統合観覧券の完全ガイド：料金、購入場所、含まれる宮殿、有効期間、節約ヒント 2026年版。',
  zh: '首尔宫殿综合门票完全指南：价格、购买地点、包含宫殿、有效期及省钱攻略 2026版。',
}[lang] ?? '';

const faqByLang: Record<string, { question: string; answer: string }[]> = {
  kr: [
    { question: '궁궐 통합관람권 가격은?', answer: '성인 ₩10,000, 청소년(7~18세) ₩5,000. 구매일로부터 1년간 유효. 7세 이하·65세 이상 무료.' },
    { question: '어떤 궁궐이 포함되나요?', answer: '5대 궁궐(경복궁, 창덕궁, 창경궁, 덕수궁, 경희궁) + 종묘 — 총 6개소.' },
    { question: '어디서 사나요?', answer: '각 궁궐 매표소에서 구매. 온라인 판매 불가. 현장 구매 필수.' },
    { question: '가성비가 좋나요?', answer: '4곳 이상 방문 시 이득. 개별 구매 시 ₩13,000 이상 소요.' },
    { question: '비원도 포함되나요?', answer: '아니요, 창덕궁 비원은 별도 추가 요금(₩5,000)이 있습니다.' },
  ],
  en: [
    { question: 'How much is the palace integrated ticket?', answer: 'Adults: ₩10,000. Youth (7–18): ₩5,000. Valid for one full year from the date of purchase. Children under 7 and seniors 65+ are free at all palaces regardless of ticket type.' },
    { question: 'Which palaces does the integrated ticket cover?', answer: 'The integrated ticket covers all five major palaces (Gyeongbokgung, Changdeokgung, Changgyeonggung, Deoksugung, Gyeonghuigung) and Jongmyo Shrine — 6 sites in total. Gyeonghuigung is a smaller palace often missed by tourists.' },
    { question: 'Where can I buy the integrated ticket?', answer: 'Available at the entrance of any of the covered palaces. You can also purchase individual tickets at each palace. The integrated ticket is not sold online — you must buy it in person.' },
    { question: 'Is the integrated ticket worth it?', answer: 'If you plan to visit 4 or more palaces, the integrated ticket saves money. Individual tickets total ₩13,000+ for all palaces. The integrated ticket at ₩10,000 covers everything plus one year of re-entry.' },
    { question: 'Does the integrated ticket include the Secret Garden?', answer: 'No, the Secret Garden at Changdeokgung requires a separate additional fee (₩5,000 adults). The integrated ticket only covers the main palace areas.' },
  ],
  ja: [
    { question: '宮殿統合観覧券の料金は？', answer: '大人₩10,000、青少年（7〜18歳）₩5,000。購入日から1年間有効。7歳未満・65歳以上は無料。' },
    { question: 'どの宮殿が含まれていますか？', answer: '5大宮殿（景福宮、昌徳宮、昌慶宮、徳寿宮、慶熙宮）+ 宗廟 — 合計6箇所。' },
    { question: 'どこで購入できますか？', answer: '各宮殿の入口にある窓口で購入。オンライン販売はなし。現地での購入必須。' },
    { question: 'コストパフォーマンスは？', answer: '4箇所以上 visiting ならお得。個別購入では₩13,000以上。統合観覧券は₩10,000で1年間の再入場も可能。' },
    { question: '秘苑も含まれますか？', answer: 'いいえ、昌徳宮の秘苑は別途追加料金（大人₩5,000）が必要です。統合観覧券は宮殿の主要エリアのみ対象。' },
  ],
  zh: [
    { question: '宫殿综合门票价格？', answer: '成人₩10,000，青少年（7-18岁）₩5,000。自购买之日起一年内有效。7岁以下及65岁以上免费。' },
    { question: '包含哪些宫殿？', answer: '五大宫殿（景福宫、昌德宫、昌庆宫、德寿宫、庆熙宫）+ 宗庙 — 共6处。' },
    { question: '在哪里购买？', answer: '在任意宫殿入口处购买。不提供在线销售，必须现场购买。' },
    { question: '性价比如何？', answer: '如果计划参观4处以上，综合门票更划算。单独购买全部宫殿门票需₩13,000以上。综合门票₩10,000覆盖全部且一年内可重复入场。' },
    { question: '包含秘苑吗？', answer: '不包含。昌德宫秘苑需额外付费（成人₩5,000）。综合门票仅覆盖宫殿主要区域。' },
  ],
};

const content = {
  kr: {
    h1: '궁궐 통합관람권 완전 가이드 2026',
    intro: '궁궐 통합관람권은 조선왕조 5대 궁궐과 종묘를 1년간 무제한 관람할 수 있는 할인 입장권입니다. 여러 궁궐을 방문할 계획이라면 탁월한 가성비를 제공합니다.',
