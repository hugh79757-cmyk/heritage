---
interface Props {
  address: Record<string, string>;
  directions: Record<string, string>;
  hours: Record<string, string>;
  duration: Record<string, string>;
  mapLinks?: {
    naver?: string;
    kakao?: string;
    google?: string;
  };
  lang: string;
}

const {
  address,
  directions,
  hours,
  duration,
  mapLinks,
  lang = 'ko',
} = Astro.props;

const langKeys = ['kr', 'en', 'ja', 'zh'] as const;
const resolvedLang = langKeys.includes(lang as any) ? lang : 'kr';
---

<aside class="quick-answer-box" data-lang={resolvedLang}>
  <div class="qab-badge">즉답</div>

  <div class="qab-row">
    <span class="qab-icon" aria-hidden="true">📍</span>
    <p class="qab-text">{address[resolvedLang] || address.kr}</p>
  </div>

  <div class="qab-row">
    <span class="qab-icon" aria-hidden="true">🚇</span>
    <p class="qab-text">{directions[resolvedLang] || directions.kr}</p>
  </div>

  <div class="qab-row">
    <span class="qab-icon" aria-hidden="true">⏰</span>
    <p class="qab-text">{hours[resolvedLang] || hours.kr}</p>
  </div>

  <div class="qab-row">
    <span class="qab-icon" aria-hidden="true">⏱</span>
    <p class="qab-text">{duration[resolvedLang] || duration.kr}</p>
  </div>

  {mapLinks && (mapLinks.naver || mapLinks.kakao || mapLinks.google) && (
    <div class="qab-maps">
      {mapLinks.naver && (
        <a href={mapLinks.naver} class="qab-map-btn" target="_blank" rel="noopener">
          네이버지도
        </a>
      )}
      {mapLinks.kakao && (
        <a href={mapLinks.kakao} class="qab-map-btn" target="_blank" rel="noopener">
          카카오맵
        </a>
      )}
      {mapLinks.google && (
        <a href={mapLinks.google} class="qab-map-btn" target="_blank" rel="noopener">
          구글맵
        </a>
      )}
    </div>
  )}
</aside>

<style>
  .quick-answer-box {
    position: relative;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-6) var(--space-6) var(--space-8);
    max-width: 600px;
    margin: var(--space-6) auto;
    font-family: inherit;
  }

  .qab-badge {
    position: absolute;
    top: -1px;
    left: var(--space-6);
    background: var(--color-card);
    color: var(--neon-gold);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-left: 3px solid var(--neon-gold);
    border-top-left-radius: var(--radius-lg);
    border-top-right-radius: 4px;
    text-transform: uppercase;
  }

  .qab-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: 14px;
    line-height: 1.5;
  }

  .qab-row:last-of-type {
    margin-bottom: 0;
  }

  .qab-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .qab-text {
    margin: 0;
    font-size: 1.05rem;
    color: var(--color-text);
    line-height: 1.5;
    word-break: keep-all;
  }

  .qab-maps {
    display: flex;
    gap: 10px;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  .qab-map-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 100px;
    padding: 9px 14px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }

  .qab-map-btn:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  @media (max-width: 480px) {
    .quick-answer-box {
      padding: 20px 16px 20px 44px;
      border-radius: 14px;
    }

    .qab-badge {
      font-size: 0.7rem;
      padding: 3px 8px;
      left: 14px;
      top: -1px;
    }

    .qab-text {
      font-size: 1rem;
    }

    .qab-icon {
      font-size: 1rem;
    }

    .qab-maps {
      gap: 8px;
    }

    .qab-map-btn {
      min-width: 0;
      padding: 8px 12px;
      font-size: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qab-map-btn {
      transition: none;
    }
  }

  .dark .quick-answer-box {
    background: #1a1825;
    border-color: rgba(255, 215, 0, 0.2);
  }

  .dark .qab-text {
    color: #E8DFD0;
  }

  .dark .qab-map-btn {
    border-color: rgba(255, 215, 0, 0.25);
    color: #E8DFD0;
  }

  .dark .qab-map-btn:hover {
    background: var(--neon-gold);
    color: #1a1825;
  }
</style>
