---
import Layout from '../../layouts/Layout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import DancheongPatterns from '../../components/DancheongPatterns.astro';
import '../../styles/global.css';
import { PALACES, getLang, getPalaceName, getPalaceDesc, getPalaceHook, fetchPalaceList, type Lang } from '../../lib/api';
import { getSceneByLocation } from '../../data/kdh-scenes';

const lang = getLang(Astro.url);
const htmlLang = lang === 'kr' ? 'ko' : lang;
const palaceId = Number(Astro.params.id);
const palace = PALACES.find((p) => p.id === palaceId);

if (!palace) return Astro.redirect('/');

const buildings = await fetchPalaceList(palaceId);
const palaceName = getPalaceName(palace, lang);
const palaceDesc = getPalaceDesc(palace, lang);
const palaceHook = getPalaceHook(palace, lang);

const palaceColors: Record<number, string> = {
  1: 'var(--palace-gyeongbok)',
  2: 'var(--palace-changdeok)',
  3: 'var(--palace-changgyeong)',
  4: 'var(--palace-deoksu)',
  5: 'var(--palace-jongmyo)',
};
const palaceHanja: Record<number, string> = {
  1: '景福宮', 2: '昌德宮', 3: '昌慶宮', 4: '德壽宮', 5: '宗廟',
};
const accentColor = palaceColors[palaceId] || 'var(--color-primary)';

// Map palace IDs to generated pastel hero images
const generatedHeroImages: Record<number, string> = {
  1: '/images/generated/gyeongbok-hero-md.webp',
  // 2: '/images/generated/changdeokgung-secret-md.webp', // pending AI generation
  // 3: '/images/generated/gyeonghoeru-night-md.webp',     // pending AI generation
  // 4: '/images/generated/deoksugung-modern-md.webp',     // pending AI generation
  // 5: '/images/generated/jongno-joseon-md.webp',         // pending AI generation
};

// Maps palace IDs to KDH scene lookup keys
const palaceToScene: Record<string, string> = {
  '1': 'gyeongbokgung',
  '2': 'changdeokgung',
  '3': 'changgyeonggung',
  '4': 'deoksugung',
};
const sceneKey = palaceToScene[Astro.params.id || ''];
const kdhScene = sceneKey ? getSceneByLocation(sceneKey) : null;

function getBuildingName(b: typeof buildings[0], lang: Lang) {
  const map: Record<Lang, string> = { kr: b.nameKr, en: b.nameEn, ja: b.nameJa, zh: b.nameZh };
  return map[lang] || b.nameKr;
}

const countLabel: Record<string, string> = {
  kr: `${buildings.length}개 건축물·유적`,
  en: `${buildings.length} buildings & sites`,
  ja: `${buildings.length}件の建築物・遺跡`,
  zh: `${buildings.length}处建筑与遗址`,
};

const guideLabels: Record<string, string> = {
  kr: '가이드 보기',
  en: 'View Guide',
  ja: 'ガイドを見る',
  zh: '查看指南',
};

const title = `${palaceName} — K-Heritage Guide`;
const description = `${palaceName} ${countLabel[lang]}`;
---
<Layout title={title} description={description} lang={htmlLang}>
  <style>@import '../../styles/global.css';</style>
  <DancheongPatterns />

  <!-- Cinematic Hero -->
  <section class="p2-cinematic-hero">
    <div class="p2-cinematic-bg">
      <img
        src={generatedHeroImages[palaceId] || palace.heroImage || palace.image}
        alt={palaceName}
        fetchpriority="high"
        width="768"
        height="512"
        style="aspect-ratio: 768/512; object-fit: cover;"
      />
    </div>
    <div class="hero-overlay"></div>
    <div class="p2-cinematic-content">
      <span class="p2-cinematic-badge">{palaceHanja[palaceId] || ''}</span>
      <h1 class="p2-cinematic-title">{palaceName}</h1>
      <p class="p2-cinematic-subtitle">{palaceHook}</p>
    </div>
  </section>

  <p class="palace-lead">{palaceDesc}</p>

  <div class="container">
    <BreadcrumbNav items={[{ name: 'Home', url: '/' }, { name: palaceName }]} lang={lang} />

    <!-- 건물 목록 -->
    <section class="building-section">
      <div class="section-header" style="padding-top:0;">
        <h2>{lang === 'kr' ? '건축물 목록' : lang === 'ja' ? '建築物一覧' : lang === 'zh' ? '建筑列表' : 'Buildings'}</h2>
      </div>

      <ul class="building-list">
        {buildings.map((b) => (
          <li style={`--bld-accent: ${accentColor}`}>
            <a href={`/palace/${palaceId}/${b.detailCode}?sn=${b.serialNumber}&lang=${lang}`}>
              {b.imageUrl && (
                <img src={b.imageUrl} alt={getBuildingName(b, lang)} loading="lazy" width="90" height="65" />
              )}
              <div class="info">
                <h3>{getBuildingName(b, lang)}</h3>
                <p>{b.explanationKr.replace(/<br\s*\/?>/g, ' ').slice(0, 80)}…</p>
              </div>
              <span class="bld-arrow">&rsaquo;</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  {kdhScene && (
    <section class="p2-kdh-connection">
      <div class="container">
        <div class="p2-kdh-connection-inner">
          <span class="kdh-connection-badge">KPop Demon Hunters</span>
          <h3>{kdhScene.sceneTitle[lang] || kdhScene.sceneTitle.en}</h3>
          <p>{(kdhScene.filmContext[lang] || kdhScene.filmContext.en).slice(0, 150)}...</p>
          <a href="/kpop-demon-hunters" class="btn btn-primary">
            {lang === 'kr' ? '전체 촬영지 보기' : lang === 'ja' ? '全ロケ地を見る' : lang === 'zh' ? '查看全部拍摄地' : 'View All Filming Locations'} &rarr;
          </a>
        </div>
      </div>
    </section>
  )}

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const list = document.querySelector('.building-list');
      if (!list) return;
      const items = list.querySelectorAll(':scope > li');
      if (items.length < 6) return;
      
      const adPositions = items.length >= 12 ? [5, 11] : [Math.floor(items.length / 2)];
      
      adPositions.forEach(pos => {
        if (pos >= items.length) return;
        const adLi = document.createElement('li');
        adLi.className = 'ad-unit-heritage';
        adLi.style.cssText = 'list-style:none;padding:1rem 0;';
        adLi.innerHTML = `<div style="text-align:center;">` +
          `<ins class="adsbygoogle" style="display:block;text-align:center" ` +
          `data-ad-layout="in-article" data-ad-format="fluid" ` +
          `data-ad-client="ca-pub-5938862195544185" data-ad-slot="4797390169"></ins>`;
        items[pos].insertAdjacentElement('afterend', adLi);
        try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch(e) {}
      });
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "TouristAttraction",
    "name": palaceName,
    "description": description,
    "image": palace.image,
    "url": `https://heritage.aikorea24.kr/palace/${palace.id}?lang=${lang}`,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Seoul",
      "addressCountry": "KR"
    },
    "isAccessibleForFree": false,
    "availableLanguage": ["ko", "en", "ja", "zh"]
  })} />
</Layout>

<style>
  /* ── P2 Cinematic Hero ── */
  .p2-cinematic-hero {
    position: relative;
    width: 100%;
    height: 60vh;
    min-height: 400px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    background: #12101A;
  }
  .p2-cinematic-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .p2-cinematic-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.55) saturate(1.3) contrast(1.1);
  }
  .p2-cinematic-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 24px 60px;
    width: 100%;
  }
  .p2-cinematic-badge {
    display: block;
    font-family: 'Noto Serif KR', serif;
    font-size: clamp(1rem, 3vw, 1.4rem);
    letter-spacing: 0.15em;
    opacity: 0.7;
    margin-bottom: 8px;
  }
  .p2-cinematic-title {
    font-family: 'Noto Serif KR', serif;
    font-weight: 900;
    font-size: clamp(2rem, 6vw, 3.2rem);
    color: #fff;
    margin-bottom: 8px;
    text-shadow: 0 2px 8px rgba(0,0,0,0.4);
  }
  .p2-cinematic-subtitle {
    font-size: 1rem;
    color: var(--color-text-light);
    margin-bottom: 24px;
  }

  .palace-lead {
    font-family: 'Noto Serif KR', serif;
    font-size: clamp(1.05rem, 2.5vw, 1.2rem);
    line-height: 1.85;
    color: var(--color-text);
    max-width: 680px;
    margin: 40px auto 0;
    padding: 0 24px;
    font-weight: 400;
  }

  @media (max-width: 640px) {
    .palace-lead { margin-top: 28px; }
  }

  /* ── KDH Connection Section ── */
  .p2-kdh-connection {
    padding: 40px 0 60px;
  }
  .p2-kdh-connection-inner {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 40px 32px;
  }
  .p2-kdh-connection-inner p {
    font-size: 0.95rem;
    color: var(--color-text-light);
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .kdh-connection-badge {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-text);
    padding: 6px 20px;
    border-radius: 30px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 20px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .p2-kdh-connection-inner h3 {
    font-family: 'Noto Serif KR', serif;
    font-size: clamp(1.2rem, 4vw, 1.6rem);
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--color-primary);
  }

  /* ── Building List (kept from original) ── */
  .building-section { padding: 0 0 60px; }
  .building-list { list-style: none; margin-top: 16px; }
  .building-list li {
    border-bottom: 1px solid var(--color-border);
    transition: background 0.2s;
  }
  .building-list li:hover {
    background: var(--color-card-hover);
  }
  .building-list a {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 8px;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-sm);
    transition: background 0.2s;
  }
  .building-list img {
    width: 90px;
    height: 65px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    filter: brightness(0.85);
    transition: filter 0.3s;
  }
  .building-list li:hover img {
    filter: brightness(1) saturate(1.2);
  }
  .building-list .info { flex: 1; min-width: 0; }
  .building-list .info h3 {
    font-size: 1rem;
    margin-bottom: 2px;
    color: var(--color-text);
    font-weight: 600;
  }
  .building-list .info p {
    font-size: 0.85rem;
    color: var(--color-text-light);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bld-arrow {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: color 0.2s;
  }
  .building-list li:hover .bld-arrow {
    color: var(--bld-accent, var(--color-primary));
  }
</style>
