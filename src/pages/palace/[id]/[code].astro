---
import Layout from '../../../layouts/Layout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import AudioGuide from '../../../components/AudioGuide.astro';
import QuickAnswerBox from '../../../components/QuickAnswerBox.astro';
import '../../../styles/global.css';
import { PALACES, getLang, getPalaceName, fetchBuildingDetail, type Lang } from '../../../lib/api';
import palaceV2 from '../../../lib/palace_v2_content.json';

const lang = getLang(Astro.url);
const htmlLang = lang === 'kr' ? 'ko' : lang;
const palaceId = Number(Astro.params.id);
const detailCode = Number(Astro.params.code);
const serialNumber = Number(Astro.url.searchParams.get('sn') || '0');

const palace = PALACES.find((p) => p.id === palaceId);
if (!palace) return Astro.redirect('/');

const detail = await fetchBuildingDetail(palaceId, serialNumber, detailCode);
if (!detail) return Astro.redirect(`/palace/${palaceId}?lang=${lang}`);

const palaceName = getPalaceName(palace, lang);

const palaceColors: Record<number, string> = {
  1: 'var(--palace-gyeongbok)',
  2: 'var(--palace-changdeok)',
  3: 'var(--palace-changgyeong)',
  4: 'var(--palace-deoksu)',
  5: 'var(--palace-jongmyo)',
};
const accentColor = palaceColors[palaceId] || 'var(--color-primary)';

function getName(lang: Lang) {
  const map: Record<Lang, string> = { kr: detail!.nameKr, en: detail!.nameEn, ja: detail!.nameJa, zh: detail!.nameZh };
  return map[lang] || detail!.nameKr;
}
function getExplanation(lang: Lang) {
  const v2Kr = palaceV2.content.kr[String(detail.serialNumber)];
  const v2En = palaceV2.content.en[String(detail.serialNumber)];
  const v2Ja = palaceV2.content.ja[String(detail.serialNumber)];
  const v2Zh = palaceV2.content.zh[String(detail.serialNumber)];
  if (lang === 'kr') return v2Kr || detail!.explanationKr;
  if (lang === 'en') return v2En || detail!.explanationEn;
  if (lang === 'ja') return v2Ja || detail!.explanationJa;
  if (lang === 'zh') return v2Zh || detail!.explanationZh;
  return detail!.explanationKr;
}
function getVideoUrl(v: typeof detail.videos[0], lang: Lang) {
  const map: Record<Lang, string> = { kr: v.urlKr, en: v.urlEn, ja: v.urlJa, zh: v.urlZh };
  return map[lang] || v.urlKr;
}

const buildingName = getName(lang);
const explanation = getExplanation(lang);
const title = `${buildingName} — ${palaceName} — K-Heritage Guide`;
const description = explanation.slice(0, 160);

const labels: Record<string, { photos: string; videos: string }> = {
  kr: { photos: '사진 갤러리', videos: '동영상' },
  en: { photos: 'Photo Gallery', videos: 'Videos' },
  ja: { photos: '写真ギャラリー', videos: '動画' },
  zh: { photos: '照片集', videos: '视频' },
};

// 궁궐별 기본 방문 정보 (QuickAnswerBox용)
const palaceVisitInfo: Record<number, {
  address: Record<string, string>;
  directions: Record<string, string>;
  hours: Record<string, string>;
  duration: Record<string, string>;
  mapLinks: { naver?: string; kakao?: string; google?: string };
}> = {
  1: {
    address: { kr: '서울특별시 종로구 사직로 161', en: '161 Sajik-ro, Jongno-gu, Seoul', ja: 'ソウル特別市 鍾路区 社稷路 161', zh: '首尔特别市钟路区社稷路161号' },
    directions: { kr: '지하철 3호선 경복궁역 5번 출구 도보 5분', en: '5 min walk from Exit 5, Gyeongbokgung Stn (Line 3)', ja: '地下鉄3号線 景福宮駅 5番出口から徒歩5分', zh: '地铁3号线景福宫站5号出口步行5分钟' },
    hours: { kr: '09:00–18:00 (화요일 휴궁, 3~10월 ~18:30)', en: '09:00–18:00 (closed Tue, until 18:30 Mar–Oct)', ja: '09:00–18:00 (火曜休宮、3〜10月は〜18:30)', zh: '09:00–18:00（周二闭宫，3-10月至18:30）' },
    duration: { kr: '약 2시간', en: 'About 2 hours', ja: '約2時間', zh: '约2小时' },
    mapLinks: {
      naver: 'https://map.naver.com/p/search/%EA%B2%BD%EB%B3%B5%EA%B6%81',
      kakao: 'https://map.kakao.com/?q=경복궁',
      google: 'https://www.google.com/maps/search/?api=1&query=Gyeongbokgung+Palace',
    },
  },
  2: {
    address: { kr: '서울특별시 종로구 율곡로 99', en: '99 Yulgok-ro, Jongno-gu, Seoul', ja: 'ソウル特別市 鍾路区 栗谷路 99', zh: '首尔特别市钟路区栗谷路99号' },
    directions: { kr: '지하철 3호선 안국역 3번 출구 도보 5분', en: '5 min walk from Exit 3, Anguk Stn (Line 3)', ja: '地下鉄3号線 安国駅 3番出口から徒歩5分', zh: '地铁3号线安国站3号出口步行5分钟' },
    hours: { kr: '09:00–18:00 (월요일 휴궁)', en: '09:00–18:00 (closed Mon)', ja: '09:00–18:00 (月曜休宮)', zh: '09:00–18:00（周一闭宫）' },
    duration: { kr: '약 2시간 30분', en: 'About 2.5 hours', ja: '約2時間30分', zh: '约2.5小时' },
    mapLinks: {
      naver: 'https://map.naver.com/p/search/%EC%B0%BD%EB%8D%95%EA%B6%81',
      kakao: 'https://map.kakao.com/?q=창덕궁',
      google: 'https://www.google.com/maps/search/?api=1&query=Changdeokgung+Palace',
    },
  },
  3: {
    address: { kr: '서울특별시 종로구 창경궁로 185', en: '185 Changgyeonggung-ro, Jongno-gu, Seoul', ja: 'ソウル特別市 鍾路区 昌慶宮路 185', zh: '首尔特别市钟路区昌庆宫路185号' },
    directions: { kr: '지하철 4호선 혜화역 4번 출구 도보 20분', en: '20 min walk from Exit 4, Hyehwa Stn (Line 4)', ja: '地下鉄4号線 恵化駅 4番出口から徒歩20分', zh: '地铁4号线惠化站4号出口步行20分钟' },
    hours: { kr: '09:00–18:00 (월요일 휴궁)', en: '09:00–18:00 (closed Mon)', ja: '09:00–18:00 (月曜休宮)', zh: '09:00–18:00（周一闭宫）' },
    duration: { kr: '약 1시간 30분', en: 'About 1.5 hours', ja: '約1時間30分', zh: '约1.5小时' },
    mapLinks: {
      naver: 'https://map.naver.com/p/search/%EC%B0%BD%EA%B2%BD%EA%B6%81',
      kakao: 'https://map.kakao.com/?q=창경궁',
      google: 'https://www.google.com/maps/search/?api=1&query=Changgyeonggung+Palace',
    },
  },
  4: {
    address: { kr: '서울특별시 중구 세종대로 99', en: '99 Sejong-daero, Jung-gu, Seoul', ja: 'ソウル特別市 中区 世宗大路 99', zh: '首尔特别市中区世宗大路99号' },
    directions: { kr: '지하철 1·2호선 시청역 2번 출구 도보 2분', en: '2 min walk from Exit 2, City Hall Stn (Lines 1 & 2)', ja: '地下鉄1・2号線 市庁駅 2番出口から徒歩2分', zh: '地铁1·2号线市厅站2号出口步行2分钟' },
    hours: { kr: '09:00–18:00 (월요일 휴궁)', en: '09:00–18:00 (closed Mon)', ja: '09:00–18:00 (月曜休宮)', zh: '09:00–18:00（周一闭宫）' },
    duration: { kr: '약 1시간', en: 'About 1 hour', ja: '約1時間', zh: '约1小时' },
    mapLinks: {
      naver: 'https://map.naver.com/p/search/%EB%8D%95%EC%88%98%EA%B6%81',
      kakao: 'https://map.kakao.com/?q=덕수궁',
      google: 'https://www.google.com/maps/search/?api=1&query=Deoksugung+Palace',
    },
  },
  5: {
    address: { kr: '서울특별시 종로구 종로 157', en: '157 Jong-ro, Jongno-gu, Seoul', ja: 'ソウル特別市 鍾路区 鍾路 157', zh: '首尔特别市钟路区钟路157号' },
    directions: { kr: '지하철 1·3·5호선 종로3가역 8번 출구 도보 5분', en: '5 min walk from Exit 8, Jongno 3-ga Stn (Lines 1, 3 & 5)', ja: '地下鉄1・3・5号線 鍾路3街駅 8番出口から徒歩5分', zh: '地铁1·3·5号线钟路3街站8号出口步行5分钟' },
    hours: { kr: '09:00–18:00 (화요일 휴묘)', en: '09:00–18:00 (closed Tue)', ja: '09:00–18:00 (火曜休廟)', zh: '09:00–18:00（周二闭庙）' },
    duration: { kr: '약 1시간 (해설 예약제)', en: 'About 1 hour (guided tour only)', ja: '約1時間 (解説予約制)', zh: '约1小时（仅限导览预约）' },
    mapLinks: {
      naver: 'https://map.naver.com/p/search/%EC%A2%85%EB%AC%98',
      kakao: 'https://map.kakao.com/?q=종묘',
      google: 'https://www.google.com/maps/search/?api=1&query=Jongmyo+Shrine',
    },
  },
};
const visit = palaceVisitInfo[palaceId] || palaceVisitInfo[1];
---
<Layout title={title} description={description} lang={htmlLang}>
  <style>@import '../../../styles/global.css';</style>

  <!-- 시네마틱 빌딩 히어로 -->
  {detail.mainImage && (
    <section class="bld-hero">
      <div class="bld-hero-bg">
        <img src={detail.mainImage} alt={buildingName} fetchpriority="high" />
      </div>
      <div class="bld-hero-overlay"></div>
      <div class="bld-hero-content">
        <span class="bld-palace-name" style={`color: ${accentColor}`}>{palaceName}</span>
        <h1 class="bld-title">{buildingName}</h1>
      </div>
    </section>
  )}

  <div class="container">
    <BreadcrumbNav items={[
      { name: 'Home', url: '/' },
      { name: palaceName, url: `/palace/${palaceId}` },
      { name: buildingName },
    ]} lang={lang} />

    <article class="bld-content">
      <!-- 즉답 정보 (방문 전 필수 정보) -->
      <QuickAnswerBox
        lang={lang}
        address={visit.address}
        directions={visit.directions}
        hours={visit.hours}
        duration={visit.duration}
        mapLinks={visit.mapLinks}
      />

      <div class="description" set:html={explanation.replace(/\n/g, "<br/>")} />

      <!-- 오디오 가이드 -->
      <AudioGuide
        asno={String(serialNumber)}
        ctcd="11"
        kdcd="11"
        lang={lang}
        name={buildingName}
        explanation={JSON.stringify({
          kr: detail.explanationKr.replace(/\r\n/g, ' '),
          en: detail.explanationEn.replace(/\r\n/g, ' '),
          ja: detail.explanationJa.replace(/\r\n/g, ' '),
          zh: detail.explanationZh.replace(/\r\n/g, ' '),
        })}
      />

      <div class="ad-container" style="margin:2rem 0;text-align:center;">
        <ins class="adsbygoogle"
             style="display:block;text-align:center"
             data-ad-layout="in-article"
             data-ad-format="fluid"
             data-ad-client="ca-pub-5938862195544185"
             data-ad-slot="4797390169"></ins>
        <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
      </div>

      {detail.images.length > 0 && (
        <>
          <h3 class="section-title" style={`border-bottom-color: ${accentColor}`}>{labels[lang].photos}</h3>
          <div class="gallery">
            {detail.images.map((img) => (
              <img src={img.url} alt={lang === 'en' ? img.descEn : img.descKr} loading="lazy" width="300" height="200" />
            ))}
          </div>
        </>
      )}

      {detail.videos.length > 0 && (
        <>
          <h3 class="section-title" style={`border-bottom-color: ${accentColor}`}>{labels[lang].videos}</h3>
          <div class="video-grid">
            {detail.videos.map((v) => (
              <video controls preload="none" poster={detail.mainImage}>
                <source src={getVideoUrl(v, lang)} type="video/mp4" />
              </video>
            ))}
          </div>
        </>
      )}

      <div class="ad-container" style="margin:2rem 0;text-align:center;">
        <ins class="adsbygoogle"
             style="display:block;text-align:center"
             data-ad-layout="in-article"
             data-ad-format="fluid"
             data-ad-client="ca-pub-5938862195544185"
             data-ad-slot="4797390169"></ins>
        <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
      </div>
    </article>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LandmarksOrHistoricalBuildings",
    "name": buildingName,
    "description": description,
    "image": detail.mainImage,
    "isPartOf": { "@type": "LandmarksOrHistoricalBuildings", "name": palaceName },
  })} />
</Layout>

<style>
  .bld-hero {
    position: relative;
    width: 100%;
    height: 50vh;
    min-height: 300px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    background: #12101A;
  }
  .bld-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .bld-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.6) saturate(1.2);
  }
  .bld-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(8,5,16,0.1) 0%, rgba(8,5,16,0.7) 60%, #12101A 100%);
  }
  .bld-hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 24px 48px;
    width: 100%;
  }
  .bld-palace-name {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
    opacity: 0.8;
  }
  .bld-title {
    font-family: 'Noto Serif KR', serif;
    font-weight: 900;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    color: #fff;
    text-shadow: 0 2px 8px rgba(0,0,0,0.4);
  }
  .bld-content {
    max-width: 800px;
    margin: 0 auto;
    padding-bottom: 60px;
  }
  .description {
    font-size: 1rem;
    line-height: 1.9;
    margin-bottom: 32px;
    white-space: pre-line;
    color: var(--color-text);
  }
</style>
