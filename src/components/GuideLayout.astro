---
interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
}

const {
  title,
  description,
  lang = 'ko',
  canonical,
} = Astro.props;

const siteUrl = 'https://heritage.aikorea24.kr';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://heritage.aikorea24.kr/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={
    lang === 'ko' ? '경복궁 근정전 야경 — K-Heritage Guide' :
    lang === 'ja' ? '景福宮 夜景 — K-Heritage Guide' :
    lang === 'zh' ? '景福宫夜景 — K-Heritage Guide' :
    'Gyeongbokgung Palace at Night — K-Heritage Guide'
  } />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="K-Heritage Guide" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://heritage.aikorea24.kr/og-image.jpg" />

  <link rel="alternate" hreflang="ko" href={`${canonicalUrl}?lang=kr`} />
  <link rel="alternate" hreflang="en" href={`${canonicalUrl}?lang=en`} />
  <link rel="alternate" hreflang="ja" href={`${canonicalUrl}?lang=ja`} />
  <link rel="alternate" hreflang="zh" href={`${canonicalUrl}?lang=zh`} />
  <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

  <script is:inline>
    (function(){
      var t=localStorage.getItem('theme');
      if(t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme:dark)').matches)){
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  <meta name="google-site-verification" content="kpr0gRmGKIFUW5dNLsfxba1aKpbV7wolSFk6cSOJZXA" />
  <meta name="naver-site-verification" content="fa2baf09d65dfb84a55787b8740941430187b234" />
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5938862195544185" crossorigin="anonymous"></script>
  <style>
    .flag-btn {
      display: inline-block;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      overflow: hidden;
      border: 2px solid rgba(255,255,255,0.3);
      cursor: pointer;
      transition: border-color 0.2s, transform 0.2s;
      flex-shrink: 0;
    }
    .flag-btn:hover {
      border-color: rgba(255,255,255,0.8);
      transform: scale(1.15);
    }
    .flag-btn.active {
      border-color: #e8a87c;
      box-shadow: 0 0 0 2px rgba(232,168,124,0.4);
    }
    .flag-btn img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  </style>
  </head>
<body>
  <nav class="site-nav" id="site-nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <span class="logo-icon">🏛</span>
        K-Heritage Guide
      </a>
      <div class="nav-actions">
        <button id="theme-toggle" class="nav-icon-btn" aria-label="Toggle dark mode" title="Toggle dark mode">
          <svg id="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg id="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <div class="nav-divider"></div>
        <a href="?lang=kr" class={`flag-btn ${lang === 'ko' ? 'active' : ''}`} title="한국어"><img src="https://flagcdn.com/w80/kr.png" alt="한국어" width="80" height="53" /></a>
        <a href="?lang=en" class={`flag-btn ${lang === 'en' ? 'active' : ''}`} title="English"><img src="https://flagcdn.com/w80/us.png" alt="English" width="80" height="53" /></a>
        <a href="?lang=ja" class={`flag-btn ${lang === 'ja' ? 'active' : ''}`} title="日本語"><img src="https://flagcdn.com/w80/jp.png" alt="日本語" width="80" height="53" /></a>
        <a href="?lang=zh" class={`flag-btn ${lang === 'zh' ? 'active' : ''}`} title="中文"><img src="https://flagcdn.com/w80/cn.png" alt="中文" width="80" height="53" /></a>
      </div>
    </div>
  </nav>

  <slot />

  <footer>
    <div class="container">
      <p>Data provided by <a href="https://www.heritage.go.kr" target="_blank" rel="noopener">Korea Heritage Service</a></p>
      <p>&copy; 2026 K-Heritage Guide</p>
    </div>
  </footer>

  <script is:inline>
    (function(){
      var nav=document.getElementById('site-nav');
      window.addEventListener('scroll',function(){
        if(window.scrollY>60) nav.classList.add('scrolled');
        else nav.classList.remove('scrolled');
      });
    })();
  </script>
  <script is:inline>
    (function(){
      var btn=document.getElementById('theme-toggle'),html=document.documentElement;
      function upd(){
        var d=html.classList.contains('dark');
        document.getElementById('icon-sun').style.display=d?'block':'none';
        document.getElementById('icon-moon').style.display=d?'none':'block';
      }
      upd();
      btn.addEventListener('click',function(){
        html.classList.toggle('dark');
        localStorage.setItem('theme',html.classList.contains('dark')?'dark':'light');
        upd();
      });
    })();
  </script>
</body>
</html>
