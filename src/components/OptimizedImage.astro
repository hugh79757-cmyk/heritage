---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className = '',
} = Astro.props;

const aspectRatio = `${width}/${height}`;
---

<img
  class={className}
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
  style={`aspect-ratio: ${aspectRatio}; object-fit: cover;`}
/>

<style>
  img {
    max-width: 100%;
    height: auto;
    background: var(--color-border, #2A2530);
  }
</style>
