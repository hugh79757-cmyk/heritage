              {index === 3 && (lang === 'kr' ? '한옥 골목 조용한 산책 — 진우·루미 "Free"' : lang === 'ja' ? '韓屋路地散策 — ジヌ・ルミ「Free」' : lang === 'zh' ? '韩屋小巷安静漫步——Jinwoo·Rumi演唱"Free"' : 'Quiet hanok alley walk — Jinwoo & Rumi sing "Free"')}
              {index === 4 && (lang === 'kr' ? '도심 번화가 퍼포먼스 — "Soda Pop" 거리 공연' : lang === 'ja' ? '都心繁華パフォーマンス — 「Soda Pop」路上公演' : lang === 'zh' ? '城市繁华表演——“Soda Pop”街头演出' : 'Downtown street performance — "Soda Pop"')}
