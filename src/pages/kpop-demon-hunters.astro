---
import GuideLayout from '../components/GuideLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQSection from '../components/FAQSection.astro';
import QuickAnswerBox from '../components/QuickAnswerBox.astro';
import '../styles/global.css';
import { KDH_SCENES, type KDHScene } from '../data/kdh-scenes';
import { getLang } from '../lib/api';

const lang = getLang(Astro.url);
const htmlLang = lang === 'kr' ? 'ko' : lang;

const titles: Record<string, string> = {
  kr: '케이팝 데몬 헌터스 — 실제 서울 영감 장소 가이드 | K-Heritage',
  en: 'KPop Demon Hunters — Real Seoul Locations Guide | K-Heritage',
  ja: 'KPop Demon Hunters — ソウル実際のインスピレーション場所ガイド | K-Heritage',
  zh: 'KPop Demon Hunters — 首尔实际灵感地点指南 | K-Heritage',
};
const descriptions: Record<string, string> = {
  kr: '케이팝 데몬 헌터스에 영감을 준 서울 장소 완전 가이드: 잠실종합운동장, 청담대교, COEX, 낙산공원, 북촌, N서울타워, 명동, 롯데월드타워, 경복궁. 순례 루트 안내.',
  en: 'Complete guide to the real Seoul locations that inspired KPop Demon Hunters: Jamsil, Cheongdam Bridge, COEX, Naksan Park, Bukchon, N Seoul Tower, Myeongdong, Lotte World Tower, and Gyeongbokgung. Plan your pilgrimage route.',
  ja: 'KPop Demon Huntersにインスピレーションを与えたソウル実在の場所の完全ガイド：蚕室、清潭橋、COEX、駱山公園、北村、Nソウルタワー、明洞、ロッテワールドタワー、景福宮。巡礼ルートのご案内。',
  zh: 'KPop Demon Hunters灵感来源首尔真实地点完全指南：蚕室、清潭大桥、COEX、骆山公园、北村、N首尔塔、明洞、乐天世界塔、景福宫。朝圣路线推荐。',
};

const faqByLang: Record<string, { question: string; answer: string }[]> = {
  kr: [
    { question: 'KPop Demon Hunters는 실제 서울에서 촬영했나요?', answer: '아니요. KPop Demon Hunters는 애니메이션 영화입니다. 아래 소개된 장소들은 실제 촬영지가 아니라, 영화 속 장면의 배경이 되거나 건축적·시각적 영감을 준 서울의 실제 공간들입니다. 각 장소 페이지의 "영화 속 장면"에서 정확한 관계를 확인할 수 있습니다.' },
    { question: '어느 장소부터 방문하는 것이 좋나요?', answer: '하루 코스를 원한다면 서울종합운동장(잠실) → COEX → 청담대교 → 명동 → 북촌 → 낙산공원 → N서울타워 순서가 지리적 흐름에 맞습니다. 경복궁과 롯데월드타워는 경로를 벗어나므로 별도 일정으로 잡으세요.' },
    { question: '롯데월드타워와 경복궁은 영화에 나오나요?', answer: '직접 등장하지 않습니다. 롯데월드타워는 헌트릭스 팀 숙소의 시각 디자인 모티프이고, 경복궁은 진우의 400년 전 회상 신 세계관의 건축적 영감입니다. 두 곳 모두 "촬영지"가 아니라 영화 미학에 영향을 준 참조 공간입니다.' },
    { question: '하루에 모든 장소를 다 갈 수 있나요?', answer: '지리적으로 가능한 7곳(잠실·COEX·청담대교·명동·북촌·낙산·N서울타워)은 하루 일정으로 묶을 수 있습니다. 경복궁과 롯데월드타워는 서울에서 떨어져 있지 않지만 별도 일정으로 보는 것이 여유롭습니다. 도보와 지하철 조합으로 이동하세요.' },
    { question: '사진 찍기 좋은 곳은 어디인가요?', answer: '낙산공원 성곽길 (서울 파노라마 뷰), 북촌 한옥마을 골목 (기와지붕과 담장), N서울타워 전망대 (야경)가 영화 속 장면 분위기를 재현하기 좋은 장소입니다. 골든아워(해 지기 1시간 전) 방문을 추천합니다.' },
  ],
  en: [
    { question: 'Was KPop Demon Hunters actually filmed in Seoul?', answer: 'No. KPop Demon Hunters is an animated film. The locations listed below are not filming locations — they are real Seoul places that inspired the film\'s scenes, or whose architecture and atmosphere provided visual reference for the animation. Each location page explains the actual relationship clearly.' },
    { question: 'Which location should I start with?', answer: 'For a one-day route, start at Jamsil Sports Complex, then move to COEX, Cheongdam Bridge, Myeongdong, Bukchon, Naksan Park, and end at N Seoul Tower. Gyeongbokgung and Lotte World Tower are slightly out of the main flow — plan them as separate stops.' },
    { question: 'Do Lotte World Tower and Gyeongbokgung appear in the film?', answer: 'Not directly. Lotte World Tower is the visual design motif behind the Huntrix team\'s base. Gyeongbokgung is the architectural inspiration for the world of Jinwoo\'s 400-year-old memory sequence. Neither is a filming location — both are references that shaped the film\'s visual language.' },
    { question: 'Can I visit all locations in one day?', answer: 'The seven locations along the central Seoul flow — Jamsil, COEX, Cheongdam Bridge, Myeongdong, Bukchon, Naksan Park, and N Seoul Tower — can be connected in a single day using subway and walking. Gyeongbokgung and Lotte World Tower are close but better as separate visits for a more relaxed pace.' },
    { question: 'Which spots are best for photos?', answer: 'Naksan Park\'s fortress wall trail (panoramic Seoul view), Bukchon\'s hanok alleyways (tiled roofs and wall compositions), and the N Seoul Tower observation deck (night skyline) are the best spots to recreate the mood of the film\'s scenes. Visit during golden hour — about one hour before sunset.' },
  ],
  ja: [
    { question: 'KPop Demon Huntersはソウルで実撮影されたのですか？', answer: 'いいえ。KPop Demon Huntersはアニメーション映画です。以下のロケ地は実際の撮影場所ではなく、映画のシーンにインスピレーションを与えた、あるいはアニメーションの視覚的参照となったソウル市の実在の空間です。各場所のページで正確な関係を確認できます。' },
    { question: 'どの場所から訪問するのがいいですか？', answer: '1日のコースなら、ソウル総合運動場(蚕室) → COEX → 清潭橋 → 明洞 → 北村 → 駱山公園 → Nソウルタワーの順が地理的な流れに合います。景福宮とロッテワールドタワーは若干外れるので、別枠で計画してください。' },
    { question: 'ロッテワールドタワーと景福宮は映画に登場しますか？', answer: '直接登場しません。ロッテワールドタワーはハントリックスチームの拠点のビジュアルデザインのモチーフであり、景福宮はジヌの400年前の回想シーンの世界の建築的インスピレーションです。どちらも「撮影地」ではなく、映画の美学に影響を与えた参照空間です。' },
    { question: '1日で全ての場所を回れますか？', answer: 'ソウル中心部の流れに乗った7箇所(蚕室・COEX・清潭橋・明洞・北村・駱山・Nソウルタワー)は、地下鉄と徒歩を組み合わせて1日でつなげられます。景福宮とロッテワールドタワーは近いが、余裕を持って別訪とするのがおすすめです。' },
    { question: '写真撮影に適した場所はどこですか？', answer: '駱山公園の城壁道(ソウルパノラマビュー)、北村韓屋村の路地(瓦屋根と塀の構成)、Nソウルタワー展望台(夜景)が、映画のシーンの雰囲気を再現しやすい場所です。ゴールデンアワー(日没1時間前)の訪問をおすすめします。' },
  ],
  zh: [
    { question: '《KPop Demon Hunters》是在首尔实景拍摄的吗？', answer: '不是。《KPop Demon Hunters》是一部动画电影。下面介绍的地点并非拍摄地，而是为电影场景提供灵感的首尔真实空间，或为动画视觉风格提供参考的建筑与氛围。每个地点的页面都说明了具体的关系。' },
    { question: '应该从哪个地点开始参观？', answer: '如果安排一日 route，建议按以下地理顺序：蚕室体育综合运动场 → COEX → 清潭大桥 → 明洞 → 北村 → 骆山公园 → N首尔塔。景福宫和乐天世界塔稍微偏离主路线，建议单独安排。' },
    { question: '乐天世界塔和景福宫在电影中出现了吗？', answer: '没有直接出现。乐天世界塔是Huntrix团队基地的视觉设计母题，景福宫则是Jinwoo 400年前回忆场景世界的建筑灵感。两者都不是“拍摄地”，而是影响电影美学的参考空间。' },
    { question: '一天能玩遍所有地点吗？', answer: '沿首尔中心区交通线的7个地点（蚕室、COEX、清潭大桥、明洞、北村、骆山公园、N首尔塔）可以用地铁和步行在一天内串联。景福宫和乐天世界塔虽然不远，但建议单独安排以放松节奏。' },
    { question: '哪里适合拍照？', answer: '骆山公园城墙道（首尔全景）、北村韩屋村小巷（瓦顶与墙面构图）、N首尔塔观景台（夜景）是最适合重现电影场景氛围的地点。建议在黄金时段（日落前1小时）参观。' },
  ],
};

const faqItems = faqByLang[lang] || faqByLang.en;

function getLocName(loc: KDHScene): string {
  const map: Record<string, string> = { kr: loc.sceneTitle.kr, en: loc.sceneTitle.en, ja: loc.sceneTitle.ja, zh: loc.sceneTitle.zh };
  return map[lang] || loc.sceneTitle.en;
}

function getLocShortDesc(loc: KDHScene): string {
  const map: Record<string, string> = { kr: loc.sceneDescription.kr, en: loc.sceneDescription.en, ja: loc.sceneDescription.ja, zh: loc.sceneDescription.zh };
  return map[lang] || loc.sceneDescription.en;
}

function getTypeLabel(loc: KDHScene): string {
  if (loc.palaceLink) return lang === 'kr' ? '건축적 영감' : lang === 'ja' ? '建築的インスピレーション' : lang === 'zh' ? '建筑灵感' : 'Architectural Inspiration';
  if (loc.id === 'lotte-world-tower') return lang === 'kr' ? '디자인 모티프' : lang === 'ja' ? 'デザイン・モチーフ' : lang === 'zh' ? '设计灵感' : 'Design Motif';
  return lang === 'kr' ? '장면 배경' : lang === 'ja' ? 'シーンの舞台' : lang === 'zh' ? '场景背景' : 'Scene Location';
}

const heroTitle: Record<string, string> = {
  en: 'KPop Demon Hunters\nReal Seoul Inspirations',
  kr: '케이팝 데몬 헌터스\n실제 서울 영감의 장소들',
  ja: 'KPop Demon Hunters\nソウル実際のインスピレーション',
  zh: 'KPop Demon Hunters\n首尔实际灵感地点',
};
const heroSub: Record<string, string> = {
  en: 'An animated film — these are not filming locations. They are the real places that gave shape to the movie\'s world.',
  kr: '애니메이션 영화입니다 — 아래 장소는 촬영지가 아닙니다. 영화 속 세계를 만든 실제 서울의 공간들입니다.',
  ja: 'アニメーション映画です — 以下の場所は撮影地ではありません。映画の世界を形作ったソウル実在の空間です。',
  zh: '这是一部动画电影——以下地点并非拍摄地。它们是塑造电影世界的首尔真实空间。',
};
const h = { title: heroTitle[lang] || heroTitle.en, sub: heroSub[lang] || heroSub.en };

const heroScene = KDH_SCENES[0]; // jamsil — first scene = hero image

// Map labels per language
const mapTitle: Record<string, string> = {
  kr: 'KPop Demon Hunters — 영감의 장소들',
  en: 'KPop Demon Hunters — Places That Inspired the Film',
  ja: 'KPop Demon Hunters — 映画にインスピレーションを与えた場所',
  zh: 'KPop Demon Hunters — 电影灵感来源地',
};
---

<GuideLayout title={titles[lang] || titles.en} description={descriptions[lang] || descriptions.en} lang={htmlLang}>
  <style>@import '../styles/global.css';</style>

  <BreadcrumbNav items={[{ name: 'Home', url: '/' }, { name: 'KPop Demon Hunters' }]} lang={lang} />

  {/* ── 히어로 ── */}
  <section class="kdh-hero">
    <div class="kdh-hero-bg">
      <img
        src={`/images/generated/${heroScene.imageId}-md.webp`}
        srcset={`/images/generated/${heroScene.imageId}-sm.webp 375w, /images/generated/${heroScene.imageId}-md.webp 768w, /images/generated/${heroScene.imageId}-lg.webp 1200w`}
        sizes="100vw"
        alt={getLocName(heroScene)}
        fetchpriority="high"
        width="768"
        height="1344"
        style="aspect-ratio: 768/1344; object-fit: cover;"
      />
    </div>
    <div class="kdh-hero-overlay"></div>
    <div class="kdh-hero-content">
      <span class="kdh-badge">KPop Demon Hunters</span>
      <h1 class="kdh-title">{h.title}</h1>
      <p class="kdh-subtitle">{h.sub}</p>
      <div class="kdh-cta">
        <a href="#map-section" class="btn btn-primary">
          {lang === 'kr' ? '지도에서 보기 ↓' : lang === 'ja' ? '地図で見る ↓' : lang === 'zh' ? '查看地图 ↓' : 'View Map ↓'}
        </a>
        <a href="#locations" class="btn btn-outline">
          {lang === 'kr' ? '9개 장소 전체 보기' : lang === 'ja' ? '9箇所すべて見る' : lang === 'zh' ? '查看全部9个地点' : 'All 9 Locations'}
        </a>
      </div>
    </div>
    <div class="hero-scroll">
      SCROLL
      <div class="hero-scroll-line"></div>
    </div>
  </section>

  {/* ── 즉답 박스 (타입 C 허브에도 하나 배치 — 대표 장소 안내) ── */}
  <div class="kdh-hero-qab container">
    <QuickAnswerBox
      address={heroScene.address}
      directions={heroScene.directions}
      hours={heroScene.hours}
      duration={heroScene.duration}
      mapLinks={heroScene.mapLinks}
      lang={lang}
    />
  </div>

  {/* ── 지도 섹션 (타입 C 허브 핵심) ── */}
  <section id="map-section" class="kdh-map-section">
    <div class="section-header">
      <h2>{mapTitle[lang]}</h2>
      <p>{lang === 'kr' ? '인터랙티브 지도에서 9개 영감의 장소를 탐색하세요. 카드와 지도가 연동되어 있습니다.' : lang === 'ja' ? 'インタラクティブマップで9つのインスピレーションソースを探索。カードとマップが連動しています。' : lang === 'zh' ? '在互动地图上探索9个灵感来源地。地图与卡片联动。' : 'Explore all 9 inspiration locations on the interactive map. Cards and map are linked.'}</p>
    </div>
    <div class="kdh-map-wrap" id="kdh-map"></div>

    <div class="location-cards-grid" id="locationSlider">
      {KDH_SCENES.map((scene, i) => (
        <div class="location-card-item" style={`--card-index: ${i}`} data-loc-id={scene.id}>
          <span class="lci-dot"></span>
          <h4 class="lci-name">{getLocName(scene)}</h4>
          <p class="lci-desc">{getLocShortDesc(scene).slice(0, 60)}…</p>
          <span class="lci-meta">{getTypeLabel(scene)} · {scene.duration[lang] || scene.duration.kr}</span>
        </div>
      ))}
    </div>
  </section>

  <hr class="dancheong-divider" />

  {/* ── 장소별 가이드 ── */}
  <section id="locations">
    <div class="section-header">
      <h2>{lang === 'kr' ? '장소별 가이드' : lang === 'ja' ? '場所別ガイド' : lang === 'zh' ? '各地点指南' : 'Location Guide'}</h2>
      <p>{lang === 'kr' ? '각 장소의 영화 속 역할과 방문 정보를 확인하세요.' : lang === 'ja' ? '各場所の映画での役割と訪問情報をご確認ください。' : lang === 'zh' ? '查看各地点在电影中的作用与参观信息。' : 'Find each location\'s role in the film and visit info.'}</p>
    </div>

    <div class="kdh-scenes">
      {KDH_SCENES.map((scene) => (
        <section class="kdh-scene" id={`scene-${scene.id}`}>
          <div class="kdh-scene-inner">
            <div class="kdh-scene-image">
              <img
                src={`/images/generated/${scene.imageId}-md.webp`}
                srcset={`/images/generated/${scene.imageId}-sm.webp 375w, /images/generated/${scene.imageId}-md.webp 768w, /images/generated/${scene.imageId}-lg.webp 1200w`}
                sizes="(max-width: 768px) 100vw, 50vw"
                alt={getLocName(scene)}
                loading="lazy"
              />
            </div>

            <div class="kdh-scene-text">
              <span class="kdh-scene-badge">{getTypeLabel(scene)}</span>
              <h3>{getLocName(scene)}</h3>
              <p class="kdh-scene-desc">{getLocShortDesc(scene)}</p>
              <div class="kdh-scene-qab-mini">
                <div class="kq-row">
                  <span class="kq-icon">📍</span>
                  <span>{scene.address[lang] || scene.address.kr}</span>
                </div>
                <div class="kq-row">
                  <span class="kq-icon">⏱</span>
                  <span>{scene.duration[lang] || scene.duration.kr}</span>
                </div>
              </div>
              <div class="kdh-scene-actions">
                {scene.palaceLink && (
                  <a href={`${scene.palaceLink}?lang=${lang}`} class="btn btn-outline">
                    {lang === 'kr' ? '경복궁 상세 →' : lang === 'ja' ? '宮殿詳細 →' : lang === 'zh' ? '查看宫殿详情 →' : 'View Palace →'}
                  </a>
                )}
                <a href={`/kpop-demon-hunters/${scene.id}?lang=${lang}`} class="btn btn-primary">
                  {lang === 'kr' ? '자세한 방문 정보' : lang === 'ja' ? '訪問情報を詳しく' : lang === 'zh' ? '查看详细参观信息' : 'Visit Info Details'}
                </a>
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>
  </section>

  <hr class="dancheong-divider" />

  {/* ── 순례 루트 ── */}
  <section class="kdh-route">
    <div class="section-header">
      <h2>{lang === 'kr' ? '하루 코스 — 영감의 장소 순례' : lang === 'ja' ? '一日コース — インスピレーションの場所巡礼' : lang === 'zh' ? '一日路线 — 灵感地点巡礼' : 'One-Day Route — Following the Inspiration'}</h2>
      <p>{lang === 'kr' ? '지리적 흐름에 따라 7곳을 하루에 묶는 코스입니다. 경복궁과 롯데월드타워는 별도 일정으로.' : lang === 'ja' ? '地理的な流れに沿って7箇所を1日で回るコース。景福宮とロッテワールドタワーは別枠で。' : lang === 'zh' ? '按地理顺序串联7个地点的一日路线。景福宫和乐天世界塔另算。' : 'A one-day route connecting 7 locations in geographic order. Gyeongbokgung and Lotte World Tower are separate visits.'}</p>
    </div>
    <div class="route-timeline">
      {KDH_SCENES.map((scene, index) => (
        <div class="route-step" key={scene.id}>
          <span class="route-time">
            {index < 7 ? ['09:00', '10:30', '12:00', '13:30', '15:00', '16:30', '18:00'][index] : (lang === 'kr' ? '별도 일정' : lang === 'ja' ? '別枠' : lang === 'zh' ? '另行安排' : 'Separate')}
          </span>
          <div class="route-info">
            <h4>{getLocName(scene)}</h4>
            <p>
              {index === 0 && (lang === 'kr' ? '오프닝 낙하산 강하 + 데뷔 무대 — 영화 첫 인상' : lang === 'ja' ? 'オープニング降下+デビュー舞台 — 映画最初の印象' : lang === 'zh' ? '开场降落伞+出道舞台——电影第一印象' : 'Opening parachute drop + debut stage — the film\'s first impression')}
              {index === 1 && (lang === 'kr' ? '한강변 고가 도로 액션 — "Takedown" OST' : lang === 'ja' ? '漢江高架道路アクション — 「Takedown」OST' : lang === 'zh' ? '汉江高架道路动作——“Takedown”原声' : 'Han River overpass action sequence — "Takedown" OST')}
