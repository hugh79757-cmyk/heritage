const lang = getLang(Astro.url);
const htmlLang = lang === 'kr' ? 'ko' : lang;

const titles: Record<string, string> = {
  kr: '궁궐 용어 사전 — K-Heritage',
  en: 'Palace Glossary — K-Heritage',
  ja: '宮殿用語辞典 — K-Heritage',
  zh: '宫殿术语词典 — K-Heritage',
};
const descriptions: Record<string, string> = {
  kr: '한국 궁궐 관람에 필요한 핵심 용어 25선 — 건축, 문화유산, 관람 정보',
  en: '25 essential Korean palace terms — architecture, heritage concepts, and visitor information.',
  ja: '韓国宮殿観光に必要な主要用語25選 — 建築、文化遺産、観光情報',
  zh: '韩国宫殿旅游必备术语25条——建筑、文化遗产、游客信息',
};

